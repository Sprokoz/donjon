function beginStageTransition(target, line1txt, line2txt, line3txt){
  stageTransitionActive=true;
  gameRunning=false;
  stageTransitionTimer=0; stageTransitionPhase=0;
  stageTransitionTarget=target;
  document.getElementById('transLine1').textContent=line1txt||'✦ STAGE CLEARED ✦';
  document.getElementById('transLine2').textContent=line2txt||'THE BATTLE CONTINUES...';
  document.getElementById('transLine3').textContent=line3txt||'⚠ THE NEXT REALM AWAITS ⚠';
  var el=document.getElementById('stageTransition');
