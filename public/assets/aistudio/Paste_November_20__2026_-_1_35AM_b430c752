// ═══════════════════════════════════════════════════
//   DRAW MECHA BOSS
// ═══════════════════════════════════════════════════
function drawMechaBoss(context){
  if(!isBossLevel||boss.health<=0||boss.state==='comic_intro'||boss.state==='dead')return;
  var isP2=boss.phase===2;
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;
  var radius=(boss.size/2)*boss.pulseSize;
  context.save();
  if(boss.shakeIntensity>0)context.translate((Math.random()-0.5)*boss.shakeIntensity,(Math.random()-0.5)*boss.shakeIntensity);

  if(boss.state==='attacking'||boss.state==='telegraph'){
    context.translate(cx,cy);
    context.rotate(boss.rotationAngle*(isP2?3:2));
    context.translate(-cx,-cy);
  }

  for(var ri=0;ri<(isP2?4:3);ri++){
    context.strokeStyle=isP2?'rgba(255,'+(100-ri*20)+',0,'+(0.6-ri*0.1)+')':'rgba('+(60+ri*20)+','+(140+ri*40)+',255,'+(0.6-ri*0.1)+')';
    context.lineWidth=isP2?5:4;
    context.setLineDash([8+ri*3,8+ri*3]); context.lineDashOffset=-(Date.now()/(100+ri*30));
    context.beginPath(); context.arc(cx,cy,radius*(0.9+ri*0.15),0,Math.PI*2); context.stroke();
    context.setLineDash([]);
  }

  var bg=context.createRadialGradient(cx,cy,0,cx,cy,radius);
  if(isP2){bg.addColorStop(0,'#2a0a00');bg.addColorStop(0.3,'#4a1200');bg.addColorStop(0.6,'#aa3300');bg.addColorStop(1,'#000000');}
  else{bg.addColorStop(0,'#001530');bg.addColorStop(0.3,'#003060');bg.addColorStop(0.6,'#1155aa');bg.addColorStop(1,'#000000');}
  context.fillStyle=bg; context.shadowColor=isP2?'#ff6600':'#4488ff'; context.shadowBlur=20;
  context.beginPath(); context.arc(cx,cy,radius,0,Math.PI*2); context.fill(); context.shadowBlur=0;
  context.strokeStyle=isP2?'#884422':'#445566'; context.lineWidth=8;
  context.beginPath(); context.arc(cx,cy,radius,0,Math.PI*2); context.stroke();

  for(var i=0;i<6;i++){
    var ang=(i/6)*Math.PI*2+boss.animationTimer*(isP2?2.5:1.2);
    var x1=cx+Math.cos(ang)*radius*0.55, y1=cy+Math.sin(ang)*radius*0.55;
    var x2=cx+Math.cos(ang)*(radius+radius*0.9*0.5), y2=cy+Math.sin(ang)*(radius+radius*0.9*0.5);
    context.strokeStyle=isP2?'#662211':'#334455'; context.lineWidth=10;
    context.beginPath(); context.moveTo(x1,y1); context.lineTo(x2,y2); context.stroke();
    context.strokeStyle=isP2?'#aa4400':'#5577aa'; context.lineWidth=4;
    context.beginPath(); context.moveTo(x1,y1); context.lineTo(x2,y2); context.stroke();
    context.fillStyle=isP2?'#ff4400':'#2266aa';
    context.shadowColor=isP2?'#ff8800':'#00aaff'; context.shadowBlur=isP2?12:8;
    context.beginPath(); context.arc(x2,y2,9,0,Math.PI*2); context.fill();
    context.strokeStyle=isP2?'#ffaa00':'#88ccff'; context.lineWidth=2; context.stroke();
    context.shadowBlur=0;
  }

  var coreR=radius*0.28;
  var coreGrad=context.createRadialGradient(cx,cy,0,cx,cy,coreR);
  if(isP2){coreGrad.addColorStop(0,'#ffffff');coreGrad.addColorStop(0.2,'#ffcc00');coreGrad.addColorStop(0.6,'#ff4400');coreGrad.addColorStop(1,'#000000');}
  else{coreGrad.addColorStop(0,'#ffffff');coreGrad.addColorStop(0.2,'#88ddff');coreGrad.addColorStop(0.6,'#0066cc');coreGrad.addColorStop(1,'#000000');}
  context.fillStyle=coreGrad; context.shadowColor=isP2?'#ff6600':'#00aaff'; context.shadowBlur=30;
  context.beginPath(); context.arc(cx,cy,coreR,0,Math.PI*2); context.fill();
  var pupilR=coreR*0.35*(0.8+Math.sin(boss.animationTimer*(isP2?8:5))*0.2);
  context.fillStyle='#000000'; context.beginPath(); context.arc(cx,cy,pupilR,0,Math.PI*2); context.fill();
  context.fillStyle='rgba(255,255,255,0.8)'; context.shadowBlur=5;
  context.beginPath(); context.arc(cx-pupilR*0.3,cy-pupilR*0.3,pupilR*0.35,0,Math.PI*2); context.fill();
  context.shadowBlur=0;

  if(boss.state==='telegraph'){
    context.strokeStyle='rgba(255,255,0,'+(0.5+Math.sin(boss.animationTimer*15)*0.5)+')';
    context.lineWidth=5; context.setLineDash([12,12]);
    context.beginPath(); context.arc(cx,cy,radius+22,0,Math.PI*2); context.stroke(); context.setLineDash([]);
  }
  if(boss.state==='weakened'){
    context.strokeStyle='rgba(0,255,255,'+(0.6+Math.sin(boss.animationTimer*10)*0.4)+')'; context.lineWidth=3;
    for(var wi=0;wi<10;wi++){
      var ca=(wi/10)*Math.PI*2, cl=radius*0.85;
      context.beginPath(); context.moveTo(cx+Math.cos(ca)*radius*0.35,cy+Math.sin(ca)*radius*0.35);
      context.lineTo(cx+Math.cos(ca)*cl,cy+Math.sin(ca)*cl); context.stroke();
    }
    context.strokeStyle='rgba(0,255,255,'+(0.5+Math.sin(boss.animationTimer*8)*0.5)+')';
    context.lineWidth=4; context.setLineDash([8,8]); context.lineDashOffset=-(Date.now()/25);
    context.beginPath(); context.arc(cx,cy,radius*1.25,0,Math.PI*2); context.stroke(); context.setLineDash([]);
    var hl=boss.maxWeakenedHits-boss.weakenedHits;
    context.fillStyle='#ffffff'; context.font='bold 16px Arial'; context.textAlign='center';
    context.strokeStyle='#000'; context.lineWidth=3;
    context.strokeText(hl+' HITS LEFT',cx,cy+radius+28); context.fillText(hl+' HITS LEFT',cx,cy+radius+28);
  }
  context.restore();
}

// ═══════════════════════════════════════════════════
//   VOID PHANTOM — TENTACLES + VISUAL
// ═══════════════════════════════════════════════════
function initVoidTentacles(){
  voidTentacles=[];
  var isP2=boss.phase===2;
  var count=isP2?8:6;
  for(var i=0;i<count;i++){
    var baseAng=(i/count)*Math.PI*2;
    voidTentacles.push({
      baseAngle: baseAng,
      segments: 8,
      segLength: 22+Math.random()*10,
      waveOffset: Math.random()*Math.PI*2,
      waveSpeed: 1.5+Math.random()*1.0,
      thickness: 8+Math.random()*4,
      extendFactor: 0,  // 0=retracted, 1=extended
      extending: false,
      retractTimer: 0,
      damageEnabled: false,
      color: isP2?'#ff0066':'#9933ff',
      glowColor: isP2?'#ff3388':'#cc66ff',
    });
  }
}

function updateVoidTentacles(dt){
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;
  var isP2=boss.phase===2;
  voidTentacles.forEach(function(t,idx){
    t.waveOffset+=t.waveSpeed*dt;
    if(t.extending){
      t.extendFactor=Math.min(1,t.extendFactor+dt*1.5);
      if(t.extendFactor>=1){
        t.damageEnabled=true;
        t.retractTimer-=dt;
        if(t.retractTimer<=0){t.extending=false;t.damageEnabled=false;}
      }
    } else {
      t.extendFactor=Math.max(0,t.extendFactor-dt*2.5);
    }

    // Damage check when extended
    if(t.damageEnabled){
      var segs=getTentacleSegments(t,cx,cy);
      var tipX=segs[segs.length-1].x, tipY=segs[segs.length-1].y;
      players.forEach(function(p){
        if(p.state==='alive'&&!p.dashImmune&&p.invulnFrames<=0&&p.postDashInvulnerability<=0){
          var dx=(p.x+p.size/2)-tipX, dy=(p.y+p.size/2)-tipY;
          if(Math.sqrt(dx*dx+dy*dy)<p.size/2+18){
            damagePlayer(p,null,null);
          }
        }
      });
    }
  });
}

function getTentacleSegments(t, cx, cy){
  var segs=[];
  var radius=(boss.size/2)*boss.pulseSize;
  var baseX=cx+Math.cos(t.baseAngle+boss.animationTimer*0.5)*radius*0.7;
  var baseY=cy+Math.sin(t.baseAngle+boss.animationTimer*0.5)*radius*0.7;
  segs.push({x:baseX,y:baseY});
  var curAng=t.baseAngle+boss.animationTimer*0.5;
  for(var s=1;s<=t.segments;s++){
    var wave=Math.sin(t.waveOffset+s*0.7)*0.4;
    var extend=t.extendFactor;
    var segLen=t.segLength*(0.5+extend*0.5)*(1-s/(t.segments*1.5))*extend;
    curAng+=wave*0.25;
    var prev=segs[segs.length-1];
    segs.push({
      x:prev.x+Math.cos(curAng)*segLen,
      y:prev.y+Math.sin(curAng)*segLen,
    });
  }
  return segs;
}

function drawVoidTentacles(context){
  if(!isBossLevel||boss.health<=0||boss.state==='comic_intro')return;
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;
  voidTentacles.forEach(function(t){
    if(t.extendFactor<0.05)return;
    var segs=getTentacleSegments(t,cx,cy);
    // Draw tentacle body
    for(var s=1;s<segs.length;s++){
      var frac=1-(s/segs.length);
      var thick=t.thickness*frac*t.extendFactor;
      if(thick<0.5)continue;
      context.beginPath();
      context.moveTo(segs[s-1].x,segs[s-1].y);
      context.lineTo(segs[s].x,segs[s].y);
      context.strokeStyle=t.color;
      context.lineWidth=thick;
      context.lineCap='round';
      context.shadowColor=t.glowColor;
      context.shadowBlur=t.damageEnabled?20:8;
      context.stroke();
      context.shadowBlur=0;
    }
    // Tip glow
    if(t.extendFactor>0.5){
      var tip=segs[segs.length-1];
      var tg=context.createRadialGradient(tip.x,tip.y,0,tip.x,tip.y,18*t.extendFactor);
      tg.addColorStop(0,t.damageEnabled?'rgba(255,255,255,0.9)':'rgba(200,100,255,0.7)');
      tg.addColorStop(0.5,t.color.replace(')',',0.6)').replace('rgb','rgba'));
      tg.addColorStop(1,'rgba(0,0,0,0)');
      context.fillStyle=tg;
      context.beginPath();
      context.arc(tip.x,tip.y,18*t.extendFactor,0,Math.PI*2);
      context.fill();
    }
  });
}

function drawVoidPhantom(context){
  if(!isBossLevel||boss.health<=0||boss.state==='comic_intro'||boss.state==='dead')return;
  context.save();
  var isPhase2=boss.phase===2;
  if(boss.shakeIntensity>0)context.translate((Math.random()-0.5)*boss.shakeIntensity,(Math.random()-0.5)*boss.shakeIntensity);
  var centerX=boss.x+boss.size/2, centerY=boss.y+boss.size/2;
  var radius=(boss.size/2)*boss.pulseSize;
  if(boss.flashIntensity>0){context.shadowColor=boss.state==='weakened'?'#00ffff':'#9900ff';context.shadowBlur=40*boss.flashIntensity;}

  // Draw tentacles first (behind body)
  context.restore();
  context.save();
  drawVoidTentacles(context);
  context.restore();
  context.save();
  if(boss.shakeIntensity>0)context.translate((Math.random()-0.5)*boss.shakeIntensity,(Math.random()-0.5)*boss.shakeIntensity);

  // Void aura rings
  for(var ri=0;ri<3;ri++){
    var ringR=radius*(1.1+ri*0.25)+Math.sin(boss.animationTimer*2+ri)*8;
    context.strokeStyle=isPhase2?
      'rgba(255,0,80,'+(0.4-ri*0.1)+')':
      'rgba(153,51,255,'+(0.5-ri*0.12)+')';
    context.lineWidth=3;
    context.setLineDash([6+ri*4,6+ri*4]);
    context.lineDashOffset=-(Date.now()/(80+ri*40));
    context.beginPath();context.arc(centerX,centerY,ringR,0,Math.PI*2);context.stroke();
    context.setLineDash([]);
  }

  // Main body
  var cg=context.createRadialGradient(centerX,centerY,0,centerX,centerY,radius);
  if(isPhase2){cg.addColorStop(0,'#330000');cg.addColorStop(0.3,'#660000');cg.addColorStop(0.6,'#cc0000');cg.addColorStop(1,'#000000');}
  else{cg.addColorStop(0,'#1a0033');cg.addColorStop(0.3,'#330066');cg.addColorStop(0.6,'#660099');cg.addColorStop(1,'#000000');}
  context.fillStyle=cg;
  context.shadowColor=isPhase2?'#ff0044':'#9900cc'; context.shadowBlur=25;
  context.beginPath();context.arc(centerX,centerY,radius,0,Math.PI*2);context.fill();

  // Void veins / cracks on surface
  for(var vi=0;vi<6;vi++){
    var vAng=(vi/6)*Math.PI*2+boss.animationTimer*0.3;
    var vPulse=0.4+Math.sin(boss.animationTimer*3+vi)*0.3;
    context.strokeStyle=isPhase2?
      'rgba(255,0,80,'+vPulse+')':
      'rgba(180,80,255,'+vPulse+')';
    context.lineWidth=2;
    context.beginPath();
    context.moveTo(centerX+Math.cos(vAng)*radius*0.2, centerY+Math.sin(vAng)*radius*0.2);
    context.lineTo(centerX+Math.cos(vAng)*radius*0.9, centerY+Math.sin(vAng)*radius*0.9);
    context.stroke();
  }

  // Floating orbs around body
  for(var i=0;i<8;i++){
    var angle=(i/8)*Math.PI*2+boss.animationTimer*2;
    var or=radius*0.6+Math.sin(boss.animationTimer*3+i)*10;
    var fx=centerX+Math.cos(angle)*or,fy=centerY+Math.sin(angle)*or;
    var fs=6+Math.sin(boss.animationTimer*4+i)*2;
    var fg=context.createRadialGradient(fx,fy,0,fx,fy,fs);
    if(isPhase2){fg.addColorStop(0,'#ff6666');fg.addColorStop(0.5,'#ff0000');fg.addColorStop(1,'rgba(255,0,0,0)');}
    else{fg.addColorStop(0,'#cc66ff');fg.addColorStop(0.5,'#9933ff');fg.addColorStop(1,'rgba(153,51,255,0)');}
    context.fillStyle=fg;context.beginPath();context.arc(fx,fy,fs,0,Math.PI*2);context.fill();
  }

  // Eye
  var eg=context.createRadialGradient(centerX,centerY-5,0,centerX,centerY,radius*0.25);
  eg.addColorStop(0,'#ffffff');
  if(isPhase2){eg.addColorStop(0.3,'#ff6666');eg.addColorStop(0.7,'#cc0000');}else{eg.addColorStop(0.3,'#cc66ff');eg.addColorStop(0.7,'#6600cc');}
  eg.addColorStop(1,'#000000');
  context.fillStyle=eg;context.shadowColor=isPhase2?'#ff0000':'#9900ff';context.shadowBlur=25;context.beginPath();context.arc(centerX,centerY,radius*0.25,0,Math.PI*2);context.fill();
  var ps=radius*0.25*0.4*(0.8+Math.sin(boss.animationTimer*(isPhase2?8:4))*0.2);
  context.fillStyle='#000000';context.shadowBlur=15;context.beginPath();context.arc(centerX,centerY,ps,0,Math.PI*2);context.fill();
  context.fillStyle='#ffffff';context.shadowBlur=5;context.beginPath();context.arc(centerX-ps*0.3,centerY-ps*0.3,ps*0.3,0,Math.PI*2);context.fill();
  context.shadowBlur=0;

  if(boss.state==='weakened'){
    context.strokeStyle='rgba(0,255,255,'+(0.6+Math.sin(boss.animationTimer*10)*0.4)+')';context.lineWidth=3;
    for(var wi=0;wi<12;wi++){var wca=(wi/12)*Math.PI*2,wcl=radius*0.8;context.beginPath();context.moveTo(centerX+Math.cos(wca)*radius*0.3,centerY+Math.sin(wca)*radius*0.3);context.lineTo(centerX+Math.cos(wca)*wcl,centerY+Math.sin(wca)*wcl);context.stroke();}
    context.strokeStyle='rgba(0,255,255,'+(0.5+Math.sin(boss.animationTimer*8)*0.5)+')';context.lineWidth=5;context.setLineDash([10,10]);context.lineDashOffset=-(Date.now()/30);context.beginPath();context.arc(centerX,centerY,radius*1.3,0,Math.PI*2);context.stroke();context.setLineDash([]);
    var whl=boss.maxWeakenedHits-boss.weakenedHits;
    context.fillStyle='#ffffff';context.font='bold 18px Arial';context.textAlign='center';context.strokeStyle='#000000';context.lineWidth=3;
    context.strokeText(whl+' HITS LEFT',centerX,centerY+radius+30);context.fillText(whl+' HITS LEFT',centerX,centerY+radius+30);
  }
  context.restore();
}

// ═══════════════════════════════════════════════════
//   DRAW ONI BOSS
// ═══════════════════════════════════════════════════
function drawOniBoss(context){
  if(!isBossLevel||boss.health<=0||boss.state==='comic_intro'||boss.state==='dead')return;
  context.save();
  var isP2=boss.phase===2;
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;
  var radius=(boss.size/2)*boss.pulseSize;
  if(boss.shakeIntensity>0)context.translate((Math.random()-0.5)*boss.shakeIntensity,(Math.random()-0.5)*boss.shakeIntensity);

  oniShrines.forEach(function(shrine){
    if(!shrine.active)return;
    var pulseFactor=1+Math.sin(boss.animationTimer*4)*0.15;
    var sc=context.createRadialGradient(shrine.x,shrine.y,0,shrine.x,shrine.y,shrine.size*pulseFactor);
    sc.addColorStop(0,isP2?'rgba(255,0,100,0.8)':'rgba(220,60,0,0.8)');
    sc.addColorStop(0.5,isP2?'rgba(180,0,60,0.5)':'rgba(160,40,0,0.5)');
    sc.addColorStop(1,'rgba(0,0,0,0)');
    context.fillStyle=sc;
    context.beginPath(); context.arc(shrine.x,shrine.y,shrine.size*pulseFactor,0,Math.PI*2); context.fill();
    context.strokeStyle=isP2?'#ff0066':'#ee4400'; context.lineWidth=4;
    context.shadowColor=isP2?'#ff0088':'#ff6600'; context.shadowBlur=15;
    context.beginPath(); context.moveTo(shrine.x-20,shrine.y-12); context.lineTo(shrine.x+20,shrine.y-12); context.stroke();
    context.beginPath(); context.moveTo(shrine.x-16,shrine.y-6); context.lineTo(shrine.x+16,shrine.y-6); context.stroke();
    context.beginPath(); context.moveTo(shrine.x-12,shrine.y-6); context.lineTo(shrine.x-12,shrine.y+14); context.stroke();
    context.beginPath(); context.moveTo(shrine.x+12,shrine.y-6); context.lineTo(shrine.x+12,shrine.y+14); context.stroke();
    context.shadowBlur=0;
    var hpPct=shrine.health/shrine.maxHealth;
    context.fillStyle='rgba(0,0,0,0.7)'; context.fillRect(shrine.x-20,shrine.y+18,40,6);
    context.fillStyle=isP2?'#ff0066':'#ee4400'; context.fillRect(shrine.x-20,shrine.y+18,40*hpPct,6);
  });

  players.forEach(function(p){
    if(p.sealed&&p.state==='alive'){
      context.save();
      var sealAlpha=0.6+Math.sin(boss.animationTimer*8)*0.4;
      context.strokeStyle='rgba(255,100,0,'+sealAlpha+')'; context.lineWidth=3;
      context.setLineDash([5,5]); context.lineDashOffset=-(Date.now()/50);
      context.beginPath(); context.arc(p.x+p.size/2,p.y+p.size/2,p.size*0.9,0,Math.PI*2); context.stroke();
      context.setLineDash([]);
      context.fillStyle='rgba(255,80,0,'+sealAlpha+')'; context.font='bold 14px Arial'; context.textAlign='center';
      context.fillText('封',p.x+p.size/2,p.y-8);
      context.restore();
    }
  });

  oniSpiritBombs.forEach(function(bomb){
    var pulseR=bomb.radius*(1+Math.sin(boss.animationTimer*6)*0.1);
    var bg2=context.createRadialGradient(bomb.x,bomb.y,0,bomb.x,bomb.y,pulseR);
    bg2.addColorStop(0,isP2?'rgba(255,50,120,0.9)':'rgba(255,80,0,0.9)');
    bg2.addColorStop(0.5,isP2?'rgba(180,0,80,0.6)':'rgba(180,40,0,0.6)');
    bg2.addColorStop(1,'rgba(0,0,0,0)');
    context.fillStyle=bg2;
    context.beginPath(); context.arc(bomb.x,bomb.y,pulseR,0,Math.PI*2); context.fill();
    context.strokeStyle=isP2?'#ff0088':'#ff8800'; context.lineWidth=3;
    context.shadowColor=isP2?'#ff0066':'#ff6600'; context.shadowBlur=20;
    context.beginPath(); context.arc(bomb.x,bomb.y,pulseR,0,Math.PI*2); context.stroke();
    context.shadowBlur=0;
    context.fillStyle='#ffffff'; context.font='bold 10px Arial'; context.textAlign='center';
    context.fillText('⚠',bomb.x,bomb.y+4);
  });

  oniCursedZones.forEach(function(zone){
    context.save();
    context.globalAlpha=zone.alpha*0.5;
    var zg=context.createRadialGradient(zone.x,zone.y,0,zone.x,zone.y,zone.radius);
    zg.addColorStop(0,zone.color);
    zg.addColorStop(1,'rgba(0,0,0,0)');
    context.fillStyle=zg;
    context.beginPath(); context.arc(zone.x,zone.y,zone.radius,0,Math.PI*2); context.fill();
    context.globalAlpha=zone.alpha;
    context.strokeStyle=zone.color; context.lineWidth=2;
    context.beginPath(); context.arc(zone.x,zone.y,zone.radius,0,Math.PI*2); context.stroke();
    context.restore();
  });

  if(boss.state==='attacking'||boss.state==='telegraph'){
    context.translate(cx,cy);
    context.rotate(boss.rotationAngle*(isP2?2:1));
    context.translate(-cx,-cy);
  }

  for(var ri=0;ri<3;ri++){
    var rRad=radius*(0.9+ri*0.2);
    context.strokeStyle=isP2?'rgba(255,'+(50-ri*10)+',100,'+(0.6-ri*0.15)+')':'rgba(220,'+(80-ri*20)+',0,'+(0.6-ri*0.15)+')';
    context.lineWidth=5;
    context.setLineDash([10,6]); context.lineDashOffset=-(Date.now()/(80+ri*40));
    context.beginPath(); context.arc(cx,cy,rRad,0,Math.PI*2); context.stroke();
    context.setLineDash([]);
  }

  var bodyG=context.createRadialGradient(cx,cy,0,cx,cy,radius);
  if(isP2){bodyG.addColorStop(0,'#2a0010');bodyG.addColorStop(0.4,'#550022');bodyG.addColorStop(0.8,'#aa0044');bodyG.addColorStop(1,'#000000');}
  else{bodyG.addColorStop(0,'#2a0800');bodyG.addColorStop(0.4,'#552200');bodyG.addColorStop(0.8,'#991100');bodyG.addColorStop(1,'#000000');}
  context.fillStyle=bodyG; context.shadowColor=isP2?'#ff0066':'#ff4400'; context.shadowBlur=25;
  context.beginPath(); context.arc(cx,cy,radius,0,Math.PI*2); context.fill(); context.shadowBlur=0;
  context.strokeStyle=isP2?'#880033':'#662200'; context.lineWidth=8;
  context.beginPath(); context.arc(cx,cy,radius,0,Math.PI*2); context.stroke();

  for(var hi=0;hi<8;hi++){
    var hAng=(hi/8)*Math.PI*2+boss.animationTimer*(isP2?1.5:0.8);
    var hLen=radius*0.7;
    var hx1=cx+Math.cos(hAng)*radius*0.6, hy1=cy+Math.sin(hAng)*radius*0.6;
    var hx2=cx+Math.cos(hAng)*(radius+hLen*0.5), hy2=cy+Math.sin(hAng)*(radius+hLen*0.5);
    context.strokeStyle=isP2?'#550022':'#441100'; context.lineWidth=12; context.lineCap='round';
    context.beginPath(); context.moveTo(hx1,hy1); context.lineTo(hx2,hy2); context.stroke();
    context.strokeStyle=isP2?'#ff0066':'#cc4400'; context.lineWidth=6;
    context.beginPath(); context.moveTo(hx1,hy1); context.lineTo(hx2,hy2); context.stroke();
    context.fillStyle=isP2?'#ff3388':'#ff6600';
    context.shadowColor=isP2?'#ff0066':'#ff4400'; context.shadowBlur=isP2?18:12;
    context.beginPath(); context.arc(hx2,hy2,10,0,Math.PI*2); context.fill();
    context.fillStyle='#000'; context.shadowBlur=0;
    context.beginPath(); context.arc(hx2,hy2,4,0,Math.PI*2); context.fill();
    context.fillStyle='rgba(255,200,100,0.9)';
    context.beginPath(); context.arc(hx2-2,hy2-2,2,0,Math.PI*2); context.fill();
  }

  for(var ki=0;ki<6;ki++){
    var kAng=(ki/6)*Math.PI*2-boss.animationTimer*(isP2?2:1);
    var kR=radius*0.55;
    context.strokeStyle=isP2?'rgba(255,0,100,0.7)':'rgba(200,80,0,0.7)'; context.lineWidth=2;
    context.beginPath();
    context.moveTo(cx+Math.cos(kAng)*radius*0.25,cy+Math.sin(kAng)*radius*0.25);
    context.lineTo(cx+Math.cos(kAng)*kR,cy+Math.sin(kAng)*kR);
    context.stroke();
  }

  var eyeR=radius*0.22;
  var eyeG=context.createRadialGradient(cx,cy,0,cx,cy,eyeR);
  if(isP2){eyeG.addColorStop(0,'#ffffff');eyeG.addColorStop(0.2,'#ffaacc');eyeG.addColorStop(0.6,'#ff0066');eyeG.addColorStop(1,'#000000');}
  else{eyeG.addColorStop(0,'#ffffff');eyeG.addColorStop(0.2,'#ffcc88');eyeG.addColorStop(0.6,'#ff6600');eyeG.addColorStop(1,'#000000');}
  context.fillStyle=eyeG; context.shadowColor=isP2?'#ff0066':'#ff6600'; context.shadowBlur=35;
  context.beginPath(); context.arc(cx,cy,eyeR,0,Math.PI*2); context.fill();
  context.fillStyle='#000000'; context.shadowBlur=0;
  context.save(); context.translate(cx,cy); context.scale(0.3,1);
  context.beginPath(); context.arc(0,0,eyeR*0.6,0,Math.PI*2); context.fill(); context.restore();
  context.fillStyle='rgba(255,200,100,0.7)'; context.shadowBlur=5;
  context.beginPath(); context.arc(cx-5,cy-5,eyeR*0.12,0,Math.PI*2); context.fill();
  context.shadowBlur=0;

  if(boss.state==='telegraph'){
    context.strokeStyle='rgba(255,220,0,'+(0.5+Math.sin(boss.animationTimer*15)*0.5)+')';
    context.lineWidth=6; context.setLineDash([12,12]);
    context.beginPath(); context.arc(cx,cy,radius+25,0,Math.PI*2); context.stroke(); context.setLineDash([]);
  }
  if(boss.state==='weakened'){
    context.strokeStyle='rgba(0,255,200,'+(0.6+Math.sin(boss.animationTimer*10)*0.4)+')'; context.lineWidth=3;
    for(var wki=0;wki<12;wki++){
      var wkca=(wki/12)*Math.PI*2,wkcl=radius*0.85;
      context.beginPath(); context.moveTo(cx+Math.cos(wkca)*radius*0.3,cy+Math.sin(wkca)*radius*0.3);
      context.lineTo(cx+Math.cos(wkca)*wkcl,cy+Math.sin(wkca)*wkcl); context.stroke();
    }
    context.strokeStyle='rgba(0,255,200,'+(0.5+Math.sin(boss.animationTimer*8)*0.5)+')';
    context.lineWidth=5; context.setLineDash([10,10]); context.lineDashOffset=-(Date.now()/30);
    context.beginPath(); context.arc(cx,cy,radius*1.3,0,Math.PI*2); context.stroke(); context.setLineDash([]);
    var wkhl=boss.maxWeakenedHits-boss.weakenedHits;
    context.fillStyle='#ffffff'; context.font='bold 16px Arial'; context.textAlign='center';
    context.strokeStyle='#000'; context.lineWidth=3;
    context.strokeText(wkhl+' HITS LEFT',cx,cy+radius+30); context.fillText(wkhl+' HITS LEFT',cx,cy+radius+30);
  }
  context.restore();
}

// ═══════════════════════════════════════════════════
//   MECHA BOSS UPDATE
// ═══════════════════════════════════════════════════
function updateMechaBoss(dt){
  if(!isBossLevel||boss.health<=0)return;
  var isP2=boss.phase===2;
  boss.animationTimer+=dt; boss.stateTimer-=dt;
  boss.pulseSize=1+Math.sin(boss.animationTimer*3)*0.1;
  boss.rotationAngle+=dt*(isP2?3.5:2);
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;

  switch(boss.state){
    case 'comic_intro':
      if(boss.entryPhase===0){
        if(!bossNameReveal){bossNameReveal=true;playSound(bossEntrySound);playSound(bossNameRevealSound);screenShake=Math.max(screenShake,20);
          for(var i=0;i<15;i++)addParticle({x:canvas.width/2,y:canvas.height/2,dx:(Math.random()-0.5)*200,dy:(Math.random()-0.5)*200,alpha:1,color:'#4488ff'});
          for(var i=0;i<8;i++)comicSlashes.push(createComicSlash(Math.random()*canvas.width,Math.random()*canvas.height,Math.random()*Math.PI*2,60+Math.random()*100));
        }
        boss.y+=100*dt;
        if(boss.y>=boss.originalY){boss.y=boss.originalY;boss.entryPhase=1;boss.shakeIntensity=25;screenShake=Math.max(screenShake,25);playSound(bossLandingSound);
          for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*25,maxRadius:400,alpha:0.8,speed:220,color:'#4488ff'});
          for(var i=0;i<35;i++)addParticle({x:boss.x+boss.size/2+(Math.random()-0.5)*150,y:boss.y+boss.size,dx:(Math.random()-0.5)*300,dy:-Math.random()*250,alpha:1,color:'#2266cc'});
        }
      } else if(boss.entryPhase===1){
        boss.shakeIntensity=Math.max(0,boss.shakeIntensity-dt*35);
        boss.flashIntensity=Math.sin(boss.animationTimer*8)*0.5+0.5;
      }
      if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1.5;boss.flashIntensity=0;bossNameReveal=false;comicSlashes=[];energyWaves=[];}
      break;

    case 'phase_transition':
      boss.pulseSize=1.2+Math.sin(boss.animationTimer*15)*0.5;boss.flashIntensity=0.8+Math.sin(boss.animationTimer*10)*0.2;
      screenShake=Math.max(screenShake,8);
      if(Math.random()<0.5)for(var i=0;i<2;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*350,dy:(Math.random()-0.5)*350,alpha:1,color:Math.random()>0.5?'#ff4400':'#ffcc00'});
      if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1;playSound(bossLandingSound);screenShake=Math.max(screenShake,15);}
      break;

    case 'idle':
      boss.flashIntensity=Math.max(0,boss.flashIntensity-dt*2);
      if(boss.stateTimer<=0){
        boss.state='telegraph'; boss.stateTimer=isP2?0.8:1.2;
        var p1attacks=['cannon_spread','laser_sweep','mine_field','gear_throw','missile_barrage'];
        var p2attacks=['cannon_spread','laser_sweep','gear_throw','missile_barrage','railgun','emp_pulse'];
        boss.attackPattern=(isP2?p2attacks:p1attacks)[Math.floor(Math.random()*(isP2?p2attacks.length:p1attacks.length))];
        playSound(bossTelegraph); screenShake=Math.max(screenShake,4); boss.flashIntensity=1;
      }
      break;

    case 'telegraph':
      boss.flashIntensity=Math.sin(boss.animationTimer*10)*0.8; boss.pulseSize=1+Math.sin(boss.animationTimer*8)*0.3;
      if(boss.stateTimer<=0){boss.state='attacking';boss.stateTimer=isP2?2.2:2.8;boss.attackTimer=0;playSound(bossAttackVortex);}
      break;

    case 'attacking':
      boss.attackTimer+=dt; boss.flashIntensity=0.3;
      var speed_mult=isP2?1.5:1.0;

      if(boss.attackPattern==='cannon_spread'){
        if(Math.floor(boss.attackTimer/0.6)>Math.floor((boss.attackTimer-dt)/0.6)){
          var np=isP2?12:8;
          var spreadAng=Math.PI*0.8;
          var startAng=Math.PI*0.1;
          for(var i=0;i<np;i++){
            var ang=startAng+(i/(np-1))*spreadAng;
            var sp=(5+Math.random()*2)*speed_mult;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*sp,dy:Math.sin(ang)*sp,size:14,speed:1,color:isP2?'#ff6600':'#4499ff'});
          }
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='laser_sweep'){
        if(boss.attackTimer>0.2&&Math.floor(boss.attackTimer/0.12)>Math.floor((boss.attackTimer-dt)/0.12)){
          var sweepA=boss.attackTimer*3.5;
          var na=isP2?5:3;
          for(var i=0;i<na;i++){
            var ang=sweepA+(i*0.2); var sp=7*speed_mult;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*sp,dy:Math.sin(ang)*sp,size:12,speed:1,color:isP2?'#ffcc00':'#00aaff'});
          }
          if(Math.random()<0.3)playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='mine_field'){
        // ── FIX 3: Mines now have a long "warning" phase before arming ──
        // They appear with a blinking warning, then arm after 2s (was 0.8s)
        if(Math.floor(boss.attackTimer/0.8)>Math.floor((boss.attackTimer-dt)/0.8)){
          var nm=isP2?4:3;
          for(var i=0;i<nm;i++){
            var mx=100+Math.random()*(canvas.width-200), my=80+Math.random()*(canvas.height-160);
            bossProjectiles.push({
              x:mx,y:my,dx:0,dy:0,size:28,speed:1,
              color:isP2?'#ff6600':'#ffcc00',
              type:'mine',timer:0,armed:false,
              warningTime:2.0,  // NEW: shows warning for 2 seconds before arming
              lifetime:5,
            });
          }
          playSound(bossTelegraph);
        }
      } else if(boss.attackPattern==='gear_throw'){
        if(Math.floor(boss.attackTimer/0.6)>Math.floor((boss.attackTimer-dt)/0.6)){
          var nd=isP2?10:6;
          for(var i=0;i<nd;i++){
            var ang=(i/nd)*Math.PI*2, sp=6*speed_mult;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*sp,dy:Math.sin(ang)*sp,size:18,speed:1,color:isP2?'#ffaa00':'#44ccff',type:'boomerang',age:0,turnTime:0.9+Math.random()*0.4});
          }
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='missile_barrage'){
        if(boss.attackTimer>0.3&&Math.floor(boss.attackTimer/0.7)>Math.floor((boss.attackTimer-dt)/0.7)){
          var nm=isP2?3:2;
          for(var i=0;i<nm;i++){
            var tp=getRandomAlivePlayer();
            var dx=(tp.x+tp.size/2)-cx, dy=(tp.y+tp.size/2)-cy;
            var d=Math.sqrt(dx*dx+dy*dy)||1; var sp=3*speed_mult;
            bossProjectiles.push({x:cx,y:cy,dx:(dx/d)*sp,dy:(dy/d)*sp,size:18,speed:1,color:isP2?'#ff4400':'#ff88ff',type:'homing',homingStr:isP2?0.10:0.07});
          }
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='railgun'){
        if(Math.floor(boss.attackTimer/0.3)>Math.floor((boss.attackTimer-dt)/0.3)&&boss.attackTimer<0.9){
          var tp=getRandomAlivePlayer();
          var dx=(tp.x+tp.size/2)-cx, dy=(tp.y+tp.size/2)-cy;
          var d=Math.sqrt(dx*dx+dy*dy)||1;
          bossProjectiles.push({x:cx,y:cy,dx:(dx/d)*16,dy:(dy/d)*16,size:20,speed:1,color:'#ff2200'});
          playSound(projectileShootSound); screenShake=Math.max(screenShake,6);
        }
      } else if(boss.attackPattern==='emp_pulse'){
        if(Math.floor(boss.attackTimer/0.7)>Math.floor((boss.attackTimer-dt)/0.7)){
          var np=16;
          for(var i=0;i<np;i++){
            var ang=(i/np)*Math.PI*2, sp=4;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*sp,dy:Math.sin(ang)*sp,size:16,speed:1,color:'#ff8800'});
          }
          playSound(bossAttackVortex); screenShake=Math.max(screenShake,8);
        }
      }

      if(boss.stateTimer<=0){
        boss.attacksBeforeVulnerable++;
        if(boss.attacksBeforeVulnerable>=boss.attacksNeeded){
          boss.state='weakened';boss.stateTimer=isP2?2.2:3.2;boss.weakenedHits=0;boss.flashIntensity=0;
          boss.attacksBeforeVulnerable=0;boss.attacksNeeded=2+Math.floor(Math.random()*2);
          playSound(bossWeakened);
        } else {boss.state='idle';boss.stateTimer=isP2?0.4:0.8;boss.flashIntensity=0;}
      }
      break;

    case 'weakened':
      boss.pulseSize=0.8+Math.sin(boss.animationTimer*6)*0.2;boss.flashIntensity=Math.sin(boss.animationTimer*4)*0.3;
      for(var pi2=0;pi2<players.length;pi2++){
        var player=players[pi2];
        if(player.state==='alive'&&player.hasKnife&&player.x<boss.x+boss.size&&player.x+player.size>boss.x&&player.y<boss.y+boss.size&&player.y+player.size>boss.y){
          boss.health--;boss.weakenedHits++;player.hasKnife=false;
          screenShake=Math.max(screenShake,15);freezeTime=0.15;updateBossHealthBar();playSound(bossDamaged);
          for(var i=0;i<12;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*200,dy:(Math.random()-0.5)*200,alpha:1,color:'#4488ff'});
          if(boss.health<=diffSettings.mechaPhase2HP&&boss.phase===1){
            boss.phase=2;boss.state='phase_transition';boss.stateTimer=3;screenShake=Math.max(screenShake,20);
            playSound(bossEntrySound);
            for(var i=0;i<50;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*400,dy:(Math.random()-0.5)*400,alpha:1,color:'#ff4400'});
            for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*35,maxRadius:450,alpha:0.9,speed:260,color:'#ff4400'});
            showPhaseAnnounce('⚡ OVERCLOCK MODE ⚡','#ff6600');
            break;
          }
          if(boss.health<=0){boss.state='dead';bossDeadTimer=0;playSound(bossDefeated);
            for(var i=0;i<60;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*500,dy:(Math.random()-0.5)*500,alpha:1,color:'#ff4400'});
            screenShake=Math.max(screenShake,30);break;
          }
        }
      }
      if(boss.stateTimer<=0||boss.weakenedHits>=boss.maxWeakenedHits){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      break;
  }
}

// ═══════════════════════════════════════════════════
//   VOID BOSS UPDATE — with tentacle attacks
// ═══════════════════════════════════════════════════
function strikeTentacles(count){
  // Extend 'count' random tentacles for a strike
  var shuffled=voidTentacles.slice().sort(function(){return Math.random()-0.5;});
  for(var i=0;i<Math.min(count,shuffled.length);i++){
    var t=shuffled[i];
    t.extending=true;
    t.extendFactor=0;
    t.retractTimer=1.2+Math.random()*0.4;
    t.damageEnabled=false;
  }
}

function updateVoidBoss(dt){
  if(!isBossLevel||boss.health<=0)return;
  var isPhase2=boss.phase===2;
  boss.animationTimer+=dt;boss.stateTimer-=dt;
  boss.pulseSize=1+Math.sin(boss.animationTimer*3)*0.1;boss.rotationAngle+=dt*2;
  var cx=boss.x+boss.size/2,cy=boss.y+boss.size/2;

  updateVoidTentacles(dt);

  switch(boss.state){
    case 'comic_intro':
      if(boss.entryPhase===0){
        if(boss.stateTimer>7.5){
          if(Math.random()<0.15)voidRifts.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height,size:0,maxSize:40+Math.random()*60,alpha:1,rotation:Math.random()*Math.PI*2,growthRate:100+Math.random()*100});
          if(Math.random()<0.4)comicSlashes.push(createComicSlash(Math.random()*canvas.width,Math.random()*canvas.height,Math.random()*Math.PI*2,80+Math.random()*120));
          screenShake=Math.max(screenShake,3+(9-boss.stateTimer)*2);
        } else {boss.entryPhase=1;comicSlashes=[];voidRifts=[];}
      } else if(boss.entryPhase===1){
        if(boss.stateTimer>6){
          if(!bossNameReveal){playSound(bossEntrySound);playSound(bossNameRevealSound);bossNameReveal=true;screenShake=Math.max(screenShake,25);
            for(var i=0;i<20;i++)addParticle({x:canvas.width/2,y:canvas.height/2,dx:(Math.random()-0.5)*300,dy:(Math.random()-0.5)*300,alpha:1,color:'#9933ff'});}
        } else boss.entryPhase=2;
      } else if(boss.entryPhase===2){
        if(boss.stateTimer>4){boss.y+=80*dt;boss.flashIntensity=Math.sin(boss.animationTimer*8)*0.5+0.5;
          if(Math.random()<0.2)addParticle({x:boss.x+boss.size/2+(Math.random()-0.5)*boss.size,y:boss.y-20,dx:(Math.random()-0.5)*100,dy:Math.random()*50,alpha:1,color:'#9933ff'});
          boss.pulseSize=1+Math.sin(boss.animationTimer*6)*0.3;
        } else boss.entryPhase=3;
      } else if(boss.entryPhase===3){
        if(boss.stateTimer>2.5){
          if(boss.y>=boss.originalY&&boss.stateTimer>3.9){boss.y=boss.originalY;boss.shakeIntensity=30;screenShake=Math.max(screenShake,25);playSound(bossLandingSound);
            for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*30,maxRadius:400,alpha:0.8,speed:250,color:'#9933ff'});
            for(var i=0;i<40;i++)addParticle({x:boss.x+boss.size/2+(Math.random()-0.5)*200,y:boss.y+boss.size,dx:(Math.random()-0.5)*400,dy:-Math.random()*300,alpha:1});}
          boss.shakeIntensity=Math.max(0,boss.shakeIntensity-dt*40);
        } else boss.entryPhase=4;
      } else if(boss.entryPhase===4){
        boss.flashIntensity=Math.sin(boss.animationTimer*12)*0.4+0.6;boss.pulseSize=1+Math.sin(boss.animationTimer*8)*0.25;
        if(Math.random()<0.25){var a=Math.random()*Math.PI*2,d=80+Math.random()*40;addParticle({x:cx+Math.cos(a)*d,y:cy+Math.sin(a)*d,dx:Math.cos(a)*50,dy:Math.sin(a)*50,alpha:1,color:'#cc66ff'});}
      }
      if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1.5;boss.flashIntensity=0;voidRifts=[];energyWaves=[];}
      break;

    case 'phase_transition':
      boss.pulseSize=1.2+Math.sin(boss.animationTimer*15)*0.5;boss.flashIntensity=0.8+Math.sin(boss.animationTimer*10)*0.2;screenShake=Math.max(screenShake,10);
      if(Math.random()<0.4)for(var i=0;i<2;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*400,dy:(Math.random()-0.5)*400,alpha:1,color:'#ff0000'});
      if(boss.stateTimer<=0){
        boss.state='idle';boss.stateTimer=1;playSound(bossLandingSound);screenShake=Math.max(screenShake,15);
        // Re-init tentacles in phase 2 colors
        initVoidTentacles();
      }
      break;

    case 'idle':
      boss.flashIntensity=Math.max(0,boss.flashIntensity-dt*2);
      if(boss.stateTimer<=0){
        boss.state='telegraph';boss.stateTimer=isPhase2?1.0:1.8;
        // ── FIX 2: Unique void attacks including tentacle strike ──
        var p1Attacks=['shotgun','boomerang','wall','sniper','portal','clone','tentacle_slash','void_drain'];
        var p2Attacks=['shotgun','boomerang','wall','sniper','portal','clone','tentacle_slam','void_vortex','shadow_copies'];
        boss.attackPattern=(isPhase2?p2Attacks:p1Attacks)[Math.floor(Math.random()*(isPhase2?p2Attacks.length:p1Attacks.length))];
        if(boss.attackPattern==='wall'){var wt=Math.random()>0.5?0:1;if(wt===0){var sx=Math.random()>0.5?-20:canvas.width+20,dx=sx<0?1:-1;boss.wallDirection={isHorizontal:true,startX:sx,dirX:dx};}else{var sy=Math.random()>0.5?-20:canvas.height+20,dy=sy<0?1:-1;boss.wallDirection={isHorizontal:false,startY:sy,dirY:dy};}}else boss.wallDirection=null;
        playSound(bossTelegraph);screenShake=Math.max(screenShake,5);boss.flashIntensity=1;
      }
      break;

    case 'telegraph':
      boss.flashIntensity=Math.sin(boss.animationTimer*10)*0.8;boss.pulseSize=1+Math.sin(boss.animationTimer*8)*0.3;
      if(boss.stateTimer<=0){boss.state='attacking';boss.stateTimer=isPhase2?3:4.5;boss.attackTimer=0;playSound(bossAttackVortex);}
      break;

    case 'attacking':
      boss.attackTimer+=dt;boss.flashIntensity=0.3;

      if(boss.attackPattern==='shotgun'){
        if(boss.attackTimer>0.3&&Math.floor(boss.attackTimer/0.5)>Math.floor((boss.attackTimer-dt)/0.5)){
          var sc=Math.floor(boss.attackTimer/0.5),sp=Math.max(0.08,1.0-sc*0.25),np=isPhase2?18:14;
          for(var i=0;i<np;i++){var ba=Math.PI/2,off=(i-np/2)*sp/np,ang=ba+off,spd=7+Math.random()*2;bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*spd,dy:Math.sin(ang)*spd,size:14,speed:1,color:'#ff6699'});}
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='boomerang'){
        if(boss.attackTimer>0.3&&Math.floor(boss.attackTimer/0.4)>Math.floor((boss.attackTimer-dt)/0.4)){
          var nd=isPhase2?12:9;
          for(var i=0;i<nd;i++){var ang=(i/nd)*Math.PI*2,spd=isPhase2?8:7.5;bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*spd,dy:Math.sin(ang)*spd,size:18,speed:1,color:isPhase2?'#ffaa00':'#00ffaa',type:'boomerang',age:0,turnTime:0.6+Math.random()*0.3});}
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='wall'){
        if(boss.attackTimer>0.5&&Math.floor(boss.attackTimer/0.8)>Math.floor((boss.attackTimer-dt)/0.8)){
          var np=isPhase2?18:13; playSound(bossAttackWall); playSound(projectileShootSound);
          if(boss.wallDirection){
            if(boss.wallDirection.isHorizontal){for(var i=0;i<np;i++){if(i>=Math.floor(np*0.44)&&i<Math.floor(np*0.56))continue;bossProjectiles.push({x:boss.wallDirection.startX,y:(i/np)*canvas.height,dx:boss.wallDirection.dirX*(isPhase2?5:4),dy:0,size:20,speed:1,color:'#ffaa00'});}}
            else{for(var i=0;i<np;i++){if(i>=Math.floor(np*0.44)&&i<Math.floor(np*0.56))continue;bossProjectiles.push({x:(i/np)*canvas.width,y:boss.wallDirection.startY,dx:0,dy:boss.wallDirection.dirY*(isPhase2?5:4),size:20,speed:1,color:'#ffaa00'});}}
          }
        }
      } else if(boss.attackPattern==='sniper'){
        var si=isPhase2?0.35:0.5;
        if(boss.attackTimer>0.3&&Math.floor(boss.attackTimer/si)>Math.floor((boss.attackTimer-dt)/si)){
          var tp=getRandomAlivePlayer();
          (function(target){setTimeout(function(){if(boss.health>0){var cdx=(target.x+target.size/2)-(boss.x+boss.size/2),cdy=(target.y+target.size/2)-(boss.y+boss.size/2),cd=Math.sqrt(cdx*cdx+cdy*cdy)||1,spd=isPhase2?15:11;bossProjectiles.push({x:boss.x+boss.size/2,y:boss.y+boss.size/2,dx:(cdx/cd)*spd,dy:(cdy/cd)*spd,size:22,speed:1,color:'#ff0000'});playSound(projectileShootSound);}},500);})(tp);
        }
      } else if(boss.attackPattern==='portal'){
        if(boss.attackTimer>0.3&&Math.floor(boss.attackTimer/0.4)>Math.floor((boss.attackTimer-dt)/0.4)){
          var np=isPhase2?3:2;
          for(var i=0;i<np;i++){var ang=Math.random()*Math.PI*2,spd=isPhase2?2.5:1.8;bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*spd,dy:Math.sin(ang)*spd,size:16,speed:1,color:'#cc00ff',type:'teleporter',teleportTimer:2+Math.random()*0.8,teleported:false,stunTimer:1,chaseSpeed:isPhase2?2.5:2,canDamage:true});}
          playSound(projectileShootSound);
        }
      } else if(boss.attackPattern==='clone'){
        if(boss.attackTimer>0.6&&boss.attackTimer<0.65){
          var cp=isPhase2?[{x:100,y:100},{x:canvas.width-160,y:100},{x:100,y:canvas.height-160},{x:canvas.width-160,y:canvas.height-160}]:[{x:150,y:150},{x:canvas.width-200,y:150},{x:canvas.width/2-30,y:canvas.height-200}];
          cp.forEach(function(pos){bossProjectiles.push({x:pos.x,y:pos.y,dx:0,dy:0,size:60,speed:1,color:isPhase2?'rgba(255,0,0,0.6)':'rgba(153,51,255,0.5)',type:'phantom_clone',lifetime:isPhase2?4:3,shootTimer:0.3,shootInterval:isPhase2?0.4:0.5,canDamage:false,spawnInvulnerability:0.8});});
          playSound(projectileShootSound);
        }

      // ── UNIQUE VOID ATTACK 1: Tentacle Slash — extends tentacles at players ──
      } else if(boss.attackPattern==='tentacle_slash'){
        if(boss.attackTimer<0.05){
          showPhaseAnnounce('☠ VOID TENTACLES!','#9933ff');
        }
        if(Math.floor(boss.attackTimer/0.9)>Math.floor((boss.attackTimer-dt)/0.9)){
          strikeTentacles(isPhase2?5:3);
          playSound(bossAttackVortex);
        }
        // Also some projectiles
        if(Math.floor(boss.attackTimer/1.4)>Math.floor((boss.attackTimer-dt)/1.4)){
          var np2=6;
          for(var i=0;i<np2;i++){
            var ang=(i/np2)*Math.PI*2;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*4,dy:Math.sin(ang)*4,size:12,speed:1,color:'#cc66ff'});
          }
        }

      // ── UNIQUE VOID ATTACK 2: Void Drain — darkness zone pulls players toward center ──
      } else if(boss.attackPattern==='void_drain'){
        if(boss.attackTimer<0.05){
          showPhaseAnnounce('⚫ VOID DRAIN — RESIST THE PULL!','#660099');
        }
        // Pull all alive players toward boss
        players.forEach(function(p){
          if(p.state==='alive'&&!p.dashImmune){
            var pdx=cx-(p.x+p.size/2), pdy=cy-(p.y+p.size/2);
            var pd=Math.sqrt(pdx*pdx+pdy*pdy)||1;
            var pullStr=isPhase2?100*dt:80*dt;
            p.x+=( pdx/pd)*pullStr;
            p.y+=( pdy/pd)*pullStr;
          }
        });
        // Spawn orbiting projectiles
        if(Math.floor(boss.attackTimer/0.25)>Math.floor((boss.attackTimer-dt)/0.25)){
          var ang=(boss.attackTimer*5)%(Math.PI*2);
          var od=120+Math.sin(boss.attackTimer*3)*30;
          bossProjectiles.push({x:cx+Math.cos(ang)*od,y:cy+Math.sin(ang)*od,dx:Math.cos(ang+Math.PI/2)*5,dy:Math.sin(ang+Math.PI/2)*5,size:16,speed:1,color:'#aa00ff'});
          bossProjectiles.push({x:cx+Math.cos(ang+Math.PI)*od,y:cy+Math.sin(ang+Math.PI)*od,dx:Math.cos(ang+Math.PI+Math.PI/2)*5,dy:Math.sin(ang+Math.PI+Math.PI/2)*5,size:16,speed:1,color:'#cc00aa'});
          if(Math.random()<0.2)playSound(projectileShootSound);
        }

      // ── UNIQUE PHASE 2 ATTACK: Tentacle Slam — ALL tentacles slam simultaneously ──
      } else if(boss.attackPattern==='tentacle_slam'){
        if(boss.attackTimer<0.05){
          showPhaseAnnounce('💀 ALL TENTACLES — SLAM!','#ff0066');
          strikeTentacles(voidTentacles.length);
          playSound(bossEntrySound);
          screenShake=Math.max(screenShake,12);
        }
        // Concurrent projectile burst
        if(boss.attackTimer>0.8&&Math.floor(boss.attackTimer/0.6)>Math.floor((boss.attackTimer-dt)/0.6)){
          var np3=isPhase2?20:14;
          for(var i=0;i<np3;i++){
            var ang=(i/np3)*Math.PI*2;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*6,dy:Math.sin(ang)*6,size:14,speed:1,color:'#ff0066'});
          }
          playSound(projectileShootSound);
        }

      // ── UNIQUE PHASE 2 ATTACK: Void Vortex — spiral + tentacles ──
      } else if(boss.attackPattern==='void_vortex'){
        if(boss.attackTimer<0.05){
          showPhaseAnnounce('🌀 VOID VORTEX!','#cc00ff');
          strikeTentacles(3);
        }
        // Continuously pull + spiral projectiles
        players.forEach(function(p){
          if(p.state==='alive'&&!p.dashImmune){
            var pdx=cx-(p.x+p.size/2), pdy=cy-(p.y+p.size/2);
            var pd=Math.sqrt(pdx*pdx+pdy*pdy)||1;
            p.x+=(pdx/pd)*40*dt;
            p.y+=(pdy/pd)*40*dt;
          }
        });
        if(Math.floor(boss.attackTimer/0.15)>Math.floor((boss.attackTimer-dt)/0.15)){
          var spiralAng=boss.attackTimer*8;
          bossProjectiles.push({x:cx,y:cy,dx:Math.cos(spiralAng)*7,dy:Math.sin(spiralAng)*7,size:14,speed:1,color:'#ff00cc'});
          bossProjectiles.push({x:cx,y:cy,dx:Math.cos(spiralAng+Math.PI)*7,dy:Math.sin(spiralAng+Math.PI)*7,size:14,speed:1,color:'#cc00ff'});
          if(boss.attackTimer>1.5){
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(spiralAng+Math.PI/2)*5,dy:Math.sin(spiralAng+Math.PI/2)*5,size:12,speed:1,color:'#9900ff'});
          }
          if(Math.random()<0.15)playSound(projectileShootSound);
        }
        // Strike more tentacles mid-attack
        if(Math.floor(boss.attackTimer/1.5)>Math.floor((boss.attackTimer-dt)/1.5)){
          strikeTentacles(2);
        }

      // ── UNIQUE PHASE 2 ATTACK: Shadow Copies that chase you ──
      } else if(boss.attackPattern==='shadow_copies'){
        if(boss.attackTimer<0.05){showPhaseAnnounce('👤 SHADOW COPIES EMERGE!','#9900ff');}
        if(boss.attackTimer>0.4&&boss.attackTimer<0.5){
          var cp2=[{x:100,y:100},{x:canvas.width-160,y:100},{x:100,y:canvas.height-160},{x:canvas.width-160,y:canvas.height-160}];
          cp2.forEach(function(pos){
            bossProjectiles.push({x:pos.x,y:pos.y,dx:0,dy:0,size:60,speed:1,color:'rgba(200,0,100,0.5)',type:'phantom_clone',lifetime:5,shootTimer:0.2,shootInterval:0.35,canDamage:false,spawnInvulnerability:0.6});
          });
          strikeTentacles(2);
          playSound(projectileShootSound);
        }
      }

      if(boss.stateTimer<=0){
        boss.attacksBeforeVulnerable++;
        if(boss.attacksBeforeVulnerable>=boss.attacksNeeded){
          boss.state='weakened';boss.stateTimer=isPhase2?2.5:4.5;boss.weakenedHits=0;boss.flashIntensity=0;
          boss.attacksBeforeVulnerable=0;boss.attacksNeeded=isPhase2?2+Math.floor(Math.random()*2):3+Math.floor(Math.random()*2);
          playSound(bossWeakened);
        } else {boss.state='idle';boss.stateTimer=isPhase2?0.5:1.3;boss.flashIntensity=0;}
      }
      break;

    case 'weakened':
      boss.pulseSize=0.8+Math.sin(boss.animationTimer*6)*0.2;boss.flashIntensity=Math.sin(boss.animationTimer*4)*0.3;
      for(var pi2=0;pi2<players.length;pi2++){
        var player=players[pi2];
        if(player.state==='alive'&&player.hasKnife&&player.x<boss.x+boss.size&&player.x+player.size>boss.x&&player.y<boss.y+boss.size&&player.y+player.size>boss.y){
          boss.health--;boss.weakenedHits++;player.hasKnife=false;
          screenShake=Math.max(screenShake,15);freezeTime=0.15;updateBossHealthBar();playSound(bossDamaged);
          for(var i=0;i<10;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*200,dy:(Math.random()-0.5)*200,alpha:1});
          var p2Threshold=diffSettings?diffSettings.phase2HP:15;
          if(boss.health<=p2Threshold&&boss.phase===1){
            boss.phase=2;boss.state='phase_transition';boss.stateTimer=3;screenShake=Math.max(screenShake,20);playSound(bossEntrySound);
            for(var i=0;i<50;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*400,dy:(Math.random()-0.5)*400,alpha:1,color:'#ff0000'});
            for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*40,maxRadius:500,alpha:0.9,speed:300,color:'#ff0000'});
            showPhaseAnnounce('⚠ VOID AWAKENED ⚠','#ff0000');
            players.forEach(function(p){if(p.state!=='spectator'){p.dash2Active=true;p.dash2Ready=true;}});
            break;
          }
          if(boss.health<=0){boss.state='dead';bossDeadTimer=0;playSound(bossDefeated);for(var i=0;i<60;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*500,dy:(Math.random()-0.5)*500,alpha:1});screenShake=Math.max(screenShake,30);break;}
        }
      }
      if(boss.stateTimer<=0||boss.weakenedHits>=boss.maxWeakenedHits){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      break;
  }
}

