function updateStageTransition(dt){
  stageTransitionTimer+=dt;
  var t=stageTransitionTimer;
  if(t>0.3&&stageTransitionPhase<1){document.getElementById('transLine1').classList.add('show');stageTransitionPhase=1;}
  if(t>0.9&&stageTransitionPhase<2){document.getElementById('transStars').classList.add('show');stageTransitionPhase=2;}
  if(t>1.6&&stageTransitionPhase<3){document.getElementById('transDivider').classList.add('show');stageTransitionPhase=3;}
  if(t>2.4&&stageTransitionPhase<4){document.getElementById('transLine2').classList.add('show');stageTransitionPhase=4;}
  if(t>3.4&&stageTransitionPhase<5){document.getElementById('transLine3').classList.add('show');stageTransitionPhase=5;}
  if(t>4.2&&stageTransitionPhase<6){document.getElementById('transLine4').classList.add('show');stageTransitionPhase=6;}
  if(t>7.0){endStageTransition();}
}

function endStageTransition(){
  stageTransitionActive=false;
  document.getElementById('stageTransition').classList.remove('active');
