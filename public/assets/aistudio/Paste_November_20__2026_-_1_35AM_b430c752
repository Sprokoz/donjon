  var colors=['#00ffff','#ff88ff'];
  var offsets=count===1?[15]:[-5,45];
  offsets.forEach(function(ox,idx){
    var c=colors[idx]; var S=4;
    ctx.fillStyle=c;
    ctx.fillRect(ox+2*S,0,3*S,3*S);
    ctx.fillRect(ox+S,3*S,5*S,4*S);
    ctx.fillRect(ox+S,7*S,2*S,2*S); ctx.fillRect(ox+4*S,7*S,2*S,2*S);
    ctx.fillRect(ox,3*S,S,3*S); ctx.fillRect(ox+6*S,3*S,S,3*S);
    ctx.shadowColor=c; ctx.shadowBlur=8;
    ctx.fillRect(ox+2*S,0,3*S,9*S);
    ctx.shadowBlur=0;
  });
}
