// ═══════════════════════════════════════════════════
//   MAIN UPDATE
// ═══════════════════════════════════════════════════
function update(dt){
  if(stageTransitionActive){updateStageTransition(dt);return;}
  var dtS=dt*timeScale;

  if(phaseAnnounceTimer>0){phaseAnnounceTimer-=dt;if(phaseAnnounceTimer<=0)phaseAnnounce.style.display='none';}

  if(introPlaying){
    introTimer+=dt;
    if(fadeOpacity>0)fadeOpacity=Math.max(0,fadeOpacity-dt*0.5);
    players.forEach(function(p){
      if(p.state==='spectator')return;
      if(p.y<LANDING_TARGET_Y){p.y+=300*dtS;if(p.y>LANDING_TARGET_Y)p.y=LANDING_TARGET_Y;}
    });
    var anyLanded=players.find(function(p){return p.state!=='spectator'&&p.y>=LANDING_TARGET_Y;});
    if(anyLanded&&landingSlowRemaining<=0){
      screenShake=Math.max(screenShake,8);playSound(landingSound);
      players.forEach(function(p){if(p.state==='spectator')return;for(var i=0;i<20;i++)addParticle({x:p.x+p.size/2+(Math.random()-0.5)*20,y:p.y+p.size,dx:(Math.random()-0.5)*200,dy:-Math.random()*120,alpha:1});});
      timeScale=0.25;landingSlowRemaining=0.5;
    }
    if(landingSlowRemaining>0){landingSlowRemaining-=dt;if(landingSlowRemaining<=0){timeScale=1;landingSlowRemaining=0;}}
    if(introTimer>INTRO_DURATION-1&&introTimer<INTRO_DURATION&&!isBossLevel)warningFlash=0.6+Math.abs(Math.sin((introTimer-(INTRO_DURATION-1))*8))*0.4;
    else warningFlash=0;
    if(introTimer>=INTRO_DURATION){
      introPlaying=false;
      players.forEach(function(p){if(p.state!=='spectator')p.invulnerable=false;});
      if(!isBossLevel)spawnEnemies();
    }
  }

  for(var i=comicSlashes.length-1;i>=0;i--){var s=comicSlashes[i];s.timer+=dt;s.alpha=Math.max(0,1-(s.timer/s.lifetime));if(s.alpha<=0)comicSlashes.splice(i,1);}
  for(var i=dustParticles.length-1;i>=0;i--){var d=dustParticles[i];d.x+=d.dx*dtS;d.y+=d.dy*dtS;d.alpha-=dt*1.5;if(d.alpha<=0)dustParticles.splice(i,1);}
  for(var i=voidRifts.length-1;i>=0;i--){var r=voidRifts[i];r.size+=r.growthRate*dt;r.rotation+=dt*3;r.alpha-=dt*0.8;if(r.alpha<=0||r.size>=r.maxSize)voidRifts.splice(i,1);}
  for(var i=energyWaves.length-1;i>=0;i--){var w=energyWaves[i];w.radius+=w.speed*dt;w.alpha-=dt*0.6;if(w.alpha<=0||w.radius>=w.maxRadius)energyWaves.splice(i,1);}
  for(var i=disintegrationEffects.length-1;i>=0;i--){var e=disintegrationEffects[i];e.x+=e.dx*dt;e.y+=e.dy*dt;e.lifetime-=dt;e.alpha=e.lifetime/0.6;e.size*=0.95;if(e.lifetime<=0)disintegrationEffects.splice(i,1);}
  for(var i=deathEffects.length-1;i>=0;i--){var e=deathEffects[i];e.lifetime-=dt;if(e.type==='shockwave'){e.radius+=200*dt;e.alpha=1-(e.radius/e.maxRadius);if(e.radius>=e.maxRadius)deathEffects.splice(i,1);}else{e.x+=e.dx*dt;e.y+=e.dy*dt;e.dy+=300*dt;e.alpha=e.lifetime;if(e.lifetime<=0)deathEffects.splice(i,1);}}

  if(introPlaying)return;
  if(freezeTime>0){freezeTime-=dt;players.forEach(function(p){p.dashTrail.forEach(function(t){t.alpha-=dt*3;});p.dashTrail=p.dashTrail.filter(function(t){return t.alpha>0;});});return;}

  updatePlayer(players[0],dt,p1Controls);
  if(numPlayers===2)updatePlayer(players[1],dt,p2Controls);

  if(bossType==='mecha')updateMechaBoss(dt);
  else if(bossType==='void')updateVoidBoss(dt);
  else if(bossType==='oni')updateOniBoss(dt);

  medkitSpawnTimer-=dt;
  if(medkitSpawnTimer<=0&&gameRunning&&!introPlaying){spawnMedkit();medkitSpawnTimer=20+Math.random()*25;}
  if(medkitNotifTimer>0){medkitNotifTimer-=dt;if(medkitNotifTimer<=0)medkitNotif.style.display='none';}

  for(var mi=medkits.length-1;mi>=0;mi--){
    var m=medkits[mi];var picked=false;
    players.forEach(function(p){
      if(picked||p.state==='spectator')return;
      if(p.state!=='alive'&&p.state!=='down')return;
      var dx=(p.x+p.size/2)-(m.x+m.size/2),dy=(p.y+p.size/2)-(m.y+m.size/2);
      if(Math.sqrt(dx*dx+dy*dy)<p.size+m.size/2){
        if(selectedDifficulty==='hard'){
          medkitInventoryCount++;updateMedkitInventoryUI();playSound(reviveSound);
          for(var i=0;i<10;i++)addParticle({x:m.x+m.size/2,y:m.y+m.size/2,dx:(Math.random()-0.5)*150,dy:-Math.random()*150,alpha:1,color:'#00ff88'});
          medkits.splice(mi,1);picked=true;
        } else {
          var healed=false;
          if(numPlayers===2){
            var downP=players.find(function(op){return op.state==='down';});
            if(downP&&p.state==='alive'){
              var odx=(p.x+p.size/2)-(downP.x+downP.size/2),ody=(p.y+p.size/2)-(downP.y+downP.size/2);
              if(Math.sqrt(odx*odx+ody*ody)<120){
                downP.hearts=1;downP.state='alive';downP.invulnerable=true;downP.reviveProgress=0;
                updateHeartsUI(downP);setTimeout(function(){if(downP.state!=='spectator')downP.invulnerable=false;},2000);healed=true;
              }
            }
          }
          if(!healed&&p.state==='alive'){p.hearts=Math.min(p.hearts+1,p.maxHearts);updateHeartsUI(p);}
          playSound(reviveSound);
          for(var i=0;i<10;i++)addParticle({x:m.x+m.size/2,y:m.y+m.size/2,dx:(Math.random()-0.5)*150,dy:-Math.random()*150,alpha:1,color:'#00ff88'});
          medkits.splice(mi,1);picked=true;
        }
      }
    });
  }

  [1,2].forEach(function(pid){var c=playerCombos[pid];if(c.timer>0){c.timer-=dt;if(c.timer<=0)resetCombo(pid);}});

  players.forEach(function(p){
    if(p.state==='spectator')return;
    var sz=p.id===1?p1SafeZone:p2SafeZone;
    if(!p.safeZoneClosed&&(p.x>sz.x+sz.width||p.y>sz.y+sz.height||p.x+p.size<sz.x||p.y+p.size<sz.y)){p.inSafeZone=false;p.safeZoneClosed=true;}
  });

  var alivePlayers=players.filter(function(p){return p.state==='alive';});
  var downPlayers=players.filter(function(p){return p.state==='down';});
  if(numPlayers===2&&alivePlayers.length>0&&downPlayers.length>0){
    downPlayers.forEach(function(downP){
      if(selectedDifficulty==='hard'){
        alivePlayers.forEach(function(aliveP){
          var dx=(aliveP.x+aliveP.size/2)-(downP.x+downP.size/2),dy=(aliveP.y+aliveP.size/2)-(downP.y+downP.size/2);
          if(Math.sqrt(dx*dx+dy*dy)<aliveP.size&&medkitInventoryCount>0){
            downP.reviveProgress+=dt;
            if(Math.random()<0.3)addParticle({x:downP.x+downP.size/2,y:downP.y+downP.size/2,dx:(Math.random()-0.5)*50,dy:-Math.random()*100,alpha:1,color:'#00ff88'});
            if(downP.reviveProgress>=REVIVE_TIME){
              medkitInventoryCount=Math.max(0,medkitInventoryCount-1);updateMedkitInventoryUI();
              downP.state='alive';downP.invulnerable=true;downP.reviveProgress=0;downP.hearts=1;
              updateHeartsUI(downP);playSound(reviveSound);
              setTimeout(function(){if(downP.state!=='spectator')downP.invulnerable=false;},2000);
            }
          } else {
            if(Math.sqrt((aliveP.x+aliveP.size/2-downP.x-downP.size/2)*(aliveP.x+aliveP.size/2-downP.x-downP.size/2)+(aliveP.y+aliveP.size/2-downP.y-downP.size/2)*(aliveP.y+aliveP.size/2-downP.y-downP.size/2))>aliveP.size){downP.reviveProgress=0;}
          }
        });
      } else {
        var reviving=false;
        alivePlayers.forEach(function(aliveP){
          var dx=(aliveP.x+aliveP.size/2)-(downP.x+downP.size/2),dy=(aliveP.y+aliveP.size/2)-(downP.y+downP.size/2);
          if(Math.sqrt(dx*dx+dy*dy)<aliveP.size){
            reviving=true;
            if(downP.reviveProgress===0)playSound(reviveSound);
            downP.reviveProgress+=dt;
            if(Math.random()<0.3)addParticle({x:downP.x+downP.size/2,y:downP.y+downP.size/2,dx:(Math.random()-0.5)*50,dy:-Math.random()*100,alpha:1,color:'#00ff00'});
            if(downP.reviveProgress>=REVIVE_TIME){downP.state='alive';downP.invulnerable=true;downP.reviveProgress=0;downP.hearts=1;updateHeartsUI(downP);setTimeout(function(){if(downP.state!=='spectator')downP.invulnerable=false;},2000);}
          }
        });
        if(!reviving)downP.reviveProgress=0;
      }
    });
  }

  // Boss projectile updates
  for(var i=bossProjectiles.length-1;i>=0;i--){
    var proj=bossProjectiles[i];
    if(!proj)continue;
    if(proj.type==='accelerating'){var acc=1.05;proj.dx*=acc;proj.dy*=acc;}
    else if(proj.type==='boomerang'){proj.age=(proj.age||0)+dt;if(proj.age>proj.turnTime&&!proj.returned){var cx2=(boss.x+boss.size/2),cy2=(boss.y+boss.size/2);var tbx=cx2-proj.x,tby=cy2-proj.y,td=Math.sqrt(tbx*tbx+tby*tby)||1,bsp=Math.sqrt(proj.dx*proj.dx+proj.dy*proj.dy);proj.dx=(tbx/td)*bsp*1.2;proj.dy=(tby/td)*bsp*1.2;proj.returned=true;}}
    else if(proj.type==='mine'){
      proj.timer+=dt;proj.lifetime-=dt;
      if(proj.lifetime<=0){bossProjectiles.splice(i,1);continue;}
      // ── FIX 3: mines don't arm until warningTime has elapsed ──
      if(proj.timer>proj.warningTime)proj.armed=true;
      if(proj.armed){
        var exploded=false;
        players.forEach(function(player){
          if(!exploded&&player.state==='alive'){
            var dx=player.x-proj.x,dy=player.y-proj.y;
            if(Math.sqrt(dx*dx+dy*dy)<55){
              for(var j=0;j<10;j++){var ba=(j/10)*Math.PI*2;bossProjectiles.push({x:proj.x,y:proj.y,dx:Math.cos(ba)*5,dy:Math.sin(ba)*5,size:14,speed:1,color:'#ff6600'});}
              bossProjectiles.splice(i,1);exploded=true;
            }
          }
        });
        if(exploded)continue;
      }
    }
    else if(proj.type==='homing'){
      var tp=getRandomAlivePlayer();
      if(tp){var dx2=(tp.x+tp.size/2)-proj.x,dy2=(tp.y+tp.size/2)-proj.y,d2=Math.sqrt(dx2*dx2+dy2*dy2)||1,hs=proj.homingStr||0.08;proj.dx+=(dx2/d2)*hs;proj.dy+=(dy2/d2)*hs;var sp2=Math.sqrt(proj.dx*proj.dx+proj.dy*proj.dy);if(sp2>6){proj.dx=(proj.dx/sp2)*6;proj.dy=(proj.dy/sp2)*6;}}
    }
    else if(proj.type==='teleporter'){
      proj.teleportTimer-=dt;
      if(proj.teleportTimer<=0&&!proj.teleported){proj.x=Math.random()*(canvas.width-40)+20;proj.y=Math.random()*(canvas.height-40)+20;proj.teleported=true;proj.canDamage=false;proj.invulnerabilityTimer=0.5;proj.dx=0;proj.dy=0;}
      if(proj.teleported&&!proj.canDamage&&proj.invulnerabilityTimer>0){proj.invulnerabilityTimer-=dt;if(proj.invulnerabilityTimer<=0)proj.canDamage=true;}
      if(proj.teleported&&proj.stunTimer>0){proj.stunTimer-=dt;if(proj.stunTimer<=0){
        var np2=getRandomAlivePlayer();
        if(np2){var d3=Math.sqrt(Math.pow(np2.x-proj.x,2)+Math.pow(np2.y-proj.y,2))||1;proj.dx=((np2.x-proj.x)/d3)*(proj.chaseSpeed||3);proj.dy=((np2.y-proj.y)/d3)*(proj.chaseSpeed||3);}
      }}
    }
    else if(proj.type==='phantom_clone'){
      proj.lifetime-=dt;if(proj.lifetime<=0){bossProjectiles.splice(i,1);continue;}
      if(!proj.canDamage){proj.spawnInvulnerability=(proj.spawnInvulnerability||0.8)-dt;if(proj.spawnInvulnerability<=0)proj.canDamage=true;}
      proj.shootTimer-=dt;if(proj.shootTimer<=0){proj.shootTimer=proj.shootInterval;
        var tp2=getRandomAlivePlayer();
        if(tp2){var dx3=(tp2.x+tp2.size/2)-(proj.x+proj.size/2),dy3=(tp2.y+tp2.size/2)-(proj.y+proj.size/2),d4=Math.sqrt(dx3*dx3+dy3*dy3)||1;bossProjectiles.push({x:proj.x+proj.size/2,y:proj.y+proj.size/2,dx:(dx3/d4)*7,dy:(dy3/d4)*7,size:14,speed:1,color:boss.phase===2?'#ff0000':'#ff66ff'});playSound(projectileShootSound);}}
      continue;
    }

    if(proj.type!=='mine'){proj.x+=proj.dx*proj.speed;proj.y+=proj.dy*proj.speed;}
    if(proj.x<-proj.size*2||proj.x>canvas.width+proj.size*2||proj.y<-proj.size*2||proj.y>canvas.height+proj.size*2){bossProjectiles.splice(i,1);continue;}

    for(var pi2=0;pi2<players.length;pi2++){
      var player=players[pi2];
      var isHittable=player.state==='alive'&&!player.dashImmune&&!player.invulnerable&&player.postDashInvulnerability<=0&&player.invulnFrames<=0;
      var canDmg=proj.canDamage!==false;
      if(isHittable&&canDmg&&player.x<proj.x+proj.size&&player.x+player.size>proj.x&&player.y<proj.y+proj.size&&player.y+player.size>proj.y){
        damagePlayer(player,bossProjectiles,i);break;
      }
    }
  }

  for(var i=enemies.length-1;i>=0;i--){
    var e=enemies[i];e.x+=e.dx*e.speed;e.y+=e.dy*e.speed;
    if(e.x<=0||e.x+e.size>=canvas.width)e.dx*=-1;
    if(e.y<=0||e.y+e.size>=canvas.height)e.dy*=-1;
    players.forEach(function(player){
      var isHittable=player.state==='alive'&&!player.invulnerable&&!player.dashImmune&&player.postDashInvulnerability<=0&&player.invulnFrames<=0;
      if(isHittable&&player.x<e.x+e.size&&player.x+player.size>e.x&&player.y<e.y+e.size&&player.y+player.size>e.y){
        if(player.hasKnife){enemies.splice(enemies.indexOf(e),1);player.hasKnife=false;playSound(killSound);screenShake=8;freezeTime=0.2;updateEnemyCount();updateCombo(player.id);createDisintegrationEffect(e.x,e.y,e.size);}
        else if(!player.inSafeZone){damagePlayer(player,null,null);}
      }
    });
  }

  players.forEach(function(player){
    knives.forEach(function(knife){
      if(knife.owner===player.id&&player.state==='alive'&&player.x<knife.x+knife.size&&player.x+player.size>knife.x&&player.y<knife.y+knife.size&&player.y+player.size>knife.y){
        if(!player.hasKnife){player.hasKnife=true;knife.x=Math.random()*700+50;knife.y=Math.random()*500+50;}
      }
    });
  });

  var activePlayers=players.filter(function(p){return p.state!=='spectator';});
  if(!gameOver&&activePlayers.every(function(p){return p.state==='down';})){
    gameOver=true;gameRunning=false;
    gameOverText.style.display='block';restartBtn.style.display='block';menuBtn.style.display='block';
    if(!isMuted){bgMusic.pause();bossMusic.pause();playSound(loseSound);}
  }

  if(currentStage==='ironDungeon'&&enemies.length===0&&!introPlaying&&gameRunning){
    startMechaBoss();introPlaying=true;introTimer=0;
  }

  // ── FIX 1: Boss death delay — celebrate first, THEN transition ──
  if(isBossLevel&&boss.state==='dead'&&gameRunning&&!stageTransitionActive){
    bossDeadTimer+=dt;
    // Celebration particles during the wait
    if(Math.random()<0.3){
      var cx3=boss.x+boss.size/2, cy3=boss.y+boss.size/2;
      addParticle({x:cx3+(Math.random()-0.5)*80,y:cy3+(Math.random()-0.5)*80,
        dx:(Math.random()-0.5)*300,dy:(Math.random()-0.5)*300,
        alpha:1,color:bossType==='mecha'?'#4488ff':bossType==='void'?'#9933ff':'#ff4400'});
    }
    if(bossDeadTimer>=BOSS_DEAD_DELAY){
      gameRunning=false;
      if(currentStage==='mechaBoss'){
        beginStageTransition('voidBoss','✦ IRON DUNGEON CLEARED ✦','THE IRON DESTROYER FALLS... SOMETHING STIRS.','⚠ THE VOID REALM AWAKENS ⚠');
      } else if(currentStage==='voidBoss'){
        beginStageTransition('oniBoss','✦ THE VOID IS SHATTERED ✦','THE VOID PHANTOM FALLS... ANCIENT DRUMS BEAT.','⛩ THE ONI SANCTUM OPENS ⛩');
      } else if(currentStage==='oniBoss'){
        setTimeout(function(){
          victoryText.style.display='block';restartBtn.style.display='block';menuBtn.style.display='block';
          if(!isMuted)bossMusic.pause();
        },2000);
      }
    }
  }
}

// ═══════════════════════════════════════════════════
//   DRAW
// ═══════════════════════════════════════════════════
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  var bg;
  if(currentStage==='oniBoss'){
    bg=ctx.createRadialGradient(canvas.width/2,canvas.height/2,0,canvas.width/2,canvas.height/2,500);
    bg.addColorStop(0,'#1a0800');bg.addColorStop(0.5,'#100400');bg.addColorStop(1,'#050200');
  } else if(currentStage==='voidBoss'){
    bg=ctx.createRadialGradient(canvas.width/2,canvas.height/2,0,canvas.width/2,canvas.height/2,500);
    bg.addColorStop(0,'#2a0055');bg.addColorStop(0.5,'#1a0033');bg.addColorStop(1,'#0a0015');
  } else {
    bg=ctx.createRadialGradient(canvas.width/2,canvas.height/2,0,canvas.width/2,canvas.height/2,500);
    bg.addColorStop(0,'#0a1a2a');bg.addColorStop(0.5,'#051018');bg.addColorStop(1,'#020810');
  }
  ctx.fillStyle=bg;ctx.fillRect(0,0,canvas.width,canvas.height);

  ctx.save();
  var gridColor=currentStage==='oniBoss'?'rgba(220,80,0,0.1)':currentStage==='voidBoss'?'rgba(153,51,255,0.1)':'rgba(0,80,180,0.12)';
  ctx.strokeStyle=gridColor;ctx.lineWidth=1;
  var gs=50,go=(Date.now()/50)%gs;
  for(var x=-go;x<canvas.width;x+=gs){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,canvas.height);ctx.stroke();}
  for(var y=-go;y<canvas.height;y+=gs){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(canvas.width,y);ctx.stroke();}
  ctx.restore();

  ctx.save();
  if(screenShake>0){ctx.translate(Math.random()*screenShake*2-screenShake,Math.random()*screenShake*2-screenShake);screenShake=Math.max(0,screenShake-0.5);}

  players.forEach(function(p){
    p.dashTrail.forEach(function(t){
      ctx.globalAlpha=t.alpha;
      ctx.fillStyle=playerColors[p.id].hex;
      ctx.fillRect(t.x,t.y,p.size,p.size);
    });
  });
  ctx.globalAlpha=1;

  var borderCol=currentStage==='oniBoss'?'rgba(220,80,0,0.8)':currentStage==='voidBoss'?'rgba(153,51,255,0.8)':'rgba(0,150,255,0.7)';
  ctx.strokeStyle=borderCol;ctx.lineWidth=5;ctx.shadowColor=borderCol;ctx.shadowBlur=15;ctx.strokeRect(0,0,canvas.width,canvas.height);ctx.shadowBlur=0;

  if(players[0].state!=='spectator'&&!players[0].safeZoneClosed){ctx.fillStyle=p1SafeZone.color;ctx.fillRect(p1SafeZone.x,p1SafeZone.y,p1SafeZone.width,p1SafeZone.height);ctx.strokeStyle='rgba(0,150,255,0.6)';ctx.lineWidth=3;ctx.strokeRect(p1SafeZone.x,p1SafeZone.y,p1SafeZone.width,p1SafeZone.height);}
  if(numPlayers===2&&players[1].state!=='spectator'&&!players[1].safeZoneClosed){ctx.fillStyle=p2SafeZone.color;ctx.fillRect(p2SafeZone.x,p2SafeZone.y,p2SafeZone.width,p2SafeZone.height);ctx.strokeStyle='rgba(255,0,255,0.6)';ctx.lineWidth=3;ctx.strokeRect(p2SafeZone.x,p2SafeZone.y,p2SafeZone.width,p2SafeZone.height);}

  players.forEach(function(p){
    if(p.state==='spectator')return;
    ctx.save();
    if(p.state==='down')ctx.globalAlpha=0.5;
    else if(p.invulnerable||p.postDashInvulnerability>0||p.invulnFrames>0)ctx.globalAlpha=0.5+Math.abs(Math.sin(Date.now()/100))*0.5;

    var pc=playerColors[p.id].hex;
    ctx.shadowColor=pc; ctx.shadowBlur=(p.sealed&&p.state==='alive')?20:8;
    ctx.fillStyle=pc;
    ctx.fillRect(p.x,p.y,p.size,p.size);
    ctx.shadowBlur=0;
    ctx.fillStyle='rgba(0,0,0,0.8)';
    ctx.font='bold 14px Arial'; ctx.textAlign='center';
    ctx.fillText('P'+p.id, p.x+p.size/2, p.y+p.size/2+5);
    ctx.restore();

    if(p.state==='alive'&&p.hasKnife){
      ctx.save();var kc=playerColors[p.id].hex;ctx.shadowColor=kc;ctx.shadowBlur=5;ctx.fillStyle=kc;
      ctx.fillRect(p.x+p.size+5,p.y+p.size/4,15,5);ctx.shadowBlur=0;ctx.restore();
    }
    if(p.state==='down'&&p.reviveProgress>0){
      ctx.fillStyle='rgba(255,255,255,0.2)';ctx.beginPath();ctx.arc(p.x+p.size/2,p.y+p.size/2,p.size/2+5,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='rgba(100,255,100,0.7)';ctx.beginPath();ctx.moveTo(p.x+p.size/2,p.y+p.size/2);
      ctx.arc(p.x+p.size/2,p.y+p.size/2,p.size/2+5,-Math.PI/2,-Math.PI/2+(Math.PI*2*(p.reviveProgress/REVIVE_TIME)));ctx.closePath();ctx.fill();
    }
    if(p.state==='down'&&selectedDifficulty==='hard'){
      ctx.fillStyle='rgba(255,180,0,0.9)';ctx.font='bold 10px Arial';ctx.textAlign='center';
      ctx.fillText(medkitInventoryCount>0?'REVIVE READY':'NEED MEDKIT',p.x+p.size/2,p.y-8);
    }
  });

  if(bossType==='mecha')drawMechaBoss(ctx);
  else if(bossType==='void')drawVoidPhantom(ctx);
  else if(bossType==='oni')drawOniBoss(ctx);

  // ── FIX 1: Draw victory explosion particles when boss is dead ──
  if(isBossLevel&&boss&&boss.state==='dead'){
    ctx.save();
    ctx.font='bold 28px Arial'; ctx.textAlign='center';
    ctx.fillStyle='rgba(255,255,100,'+(0.7+Math.sin(Date.now()/150)*0.3)+')';
    ctx.shadowColor='#ffff00'; ctx.shadowBlur=30;
    ctx.fillText('⚡ DEFEATED! ⚡', canvas.width/2, canvas.height/2-30);
    ctx.shadowBlur=0;
    ctx.restore();
  }

  // Boss projectiles
  bossProjectiles.forEach(function(proj){
    if(!proj)return;
    if(proj.type==='phantom_clone'){
      ctx.save();ctx.globalAlpha=0.6+Math.sin(Date.now()/100)*0.2;
      var pcx=proj.x+proj.size/2,pcy=proj.y+proj.size/2,pr=proj.size/2;
      var pg=ctx.createRadialGradient(pcx,pcy,0,pcx,pcy,pr);
      pg.addColorStop(0,'#9933ff');pg.addColorStop(0.5,'#6600cc');pg.addColorStop(1,'rgba(102,0,204,0)');
      ctx.fillStyle=pg;ctx.beginPath();ctx.arc(pcx,pcy,pr,0,Math.PI*2);ctx.fill();ctx.restore();
    } else if(proj.type==='mine'){
      // ── FIX 3: Draw mine with warning phase clearly visible ──
      var isArmed=proj.armed;
      var isWarning=!isArmed; // still in warning phase
      var warnFrac=proj.timer/proj.warningTime; // 0=just spawned, 1=about to arm
      
      // Warning pulse ring (shrinks as mine gets closer to arming)
      if(isWarning){
        var pulseR=40*(1-warnFrac);
        ctx.strokeStyle='rgba(255,220,0,'+(0.6*(1-warnFrac))+')';
        ctx.lineWidth=3;
        ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2+pulseR,0,Math.PI*2);ctx.stroke();
        // Warning text
        ctx.fillStyle='rgba(255,220,0,'+(0.8+Math.sin(Date.now()/120)*0.2)+')';
        ctx.font='bold 10px Arial';ctx.textAlign='center';
        ctx.fillText('MINE!',proj.x+proj.size/2,proj.y-8);
      }
      
      // Mine body — grey when warning, colored when armed
      ctx.fillStyle=isArmed?proj.color:'#888888';
      ctx.shadowColor=isArmed?proj.color:'#888888';
      ctx.shadowBlur=isArmed?14:5;
      ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2,0,Math.PI*2);ctx.fill();
      
      if(isArmed){
        ctx.strokeStyle='#ff0000';ctx.lineWidth=3;ctx.stroke();
        if(Math.sin(Date.now()/150)>0){ctx.fillStyle='#ffffff';ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,4,0,Math.PI*2);ctx.fill();}
      } else {
        // Show a filling ring to indicate arming progress
        ctx.strokeStyle='rgba(255,200,0,0.8)';ctx.lineWidth=4;
        ctx.beginPath();
        ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2,-Math.PI/2,-Math.PI/2+Math.PI*2*warnFrac);
        ctx.stroke();
        ctx.strokeStyle='#555555';ctx.lineWidth=2;
        ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2,0,Math.PI*2);ctx.stroke();
      }
      ctx.shadowBlur=0;
    } else if(proj.type==='boomerang'){
      ctx.save();ctx.fillStyle=proj.color;ctx.shadowColor=proj.color;ctx.shadowBlur=12;
      ctx.translate(proj.x+proj.size/2,proj.y+proj.size/2);ctx.rotate((proj.age||0)*10);
      ctx.fillRect(-proj.size/2,-3,proj.size,6);ctx.fillRect(-3,-proj.size/2,6,proj.size);ctx.restore();
    } else if(proj.type==='homing'){
      ctx.fillStyle=proj.color;ctx.shadowColor=proj.color;ctx.shadowBlur=15;
      ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle='rgba(255,255,255,0.6)';ctx.lineWidth=2;ctx.stroke();ctx.shadowBlur=0;
    } else {
      ctx.fillStyle=proj.color;ctx.shadowColor=proj.color;ctx.shadowBlur=15;
      ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/2,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
      ctx.fillStyle='rgba(255,255,255,0.5)';ctx.beginPath();ctx.arc(proj.x+proj.size/2,proj.y+proj.size/2,proj.size/4,0,Math.PI*2);ctx.fill();
    }
  });

  comicSlashes.forEach(function(slash){
    ctx.save();ctx.globalAlpha=slash.alpha;ctx.strokeStyle='#ffffff';ctx.lineWidth=slash.thickness;ctx.lineCap='round';
    var ex=slash.x+Math.cos(slash.angle)*slash.length,ey=slash.y+Math.sin(slash.angle)*slash.length;
    ctx.beginPath();ctx.moveTo(slash.x,slash.y);ctx.lineTo(ex,ey);ctx.stroke();
    ctx.fillStyle='#ffff00';for(var i=0;i<3;i++){var t=i/2,x=slash.x+(ex-slash.x)*t,y=slash.y+(ey-slash.y)*t;ctx.beginPath();ctx.arc(x,y,3,0,Math.PI*2);ctx.fill();}
    ctx.restore();
  });

  var showKnives=!isBossLevel||(isBossLevel&&boss.state!=='comic_intro');
  if(showKnives){
    knives.forEach(function(k){
      ctx.save();ctx.shadowColor=k.color;ctx.shadowBlur=10;ctx.fillStyle=k.color;ctx.beginPath();ctx.arc(k.x+k.size/2,k.y+k.size/2,k.size/2,0,Math.PI*2);ctx.fill();
      ctx.fillStyle='white';ctx.beginPath();ctx.moveTo(k.x+k.size/2-3,k.y+k.size/2-5);ctx.lineTo(k.x+k.size/2+3,k.y+k.size/2-5);ctx.lineTo(k.x+k.size/2+1,k.y+k.size/2+5);ctx.lineTo(k.x+k.size/2-1,k.y+k.size/2+5);ctx.closePath();ctx.fill();ctx.shadowBlur=0;ctx.restore();
    });
  }

  if(!isBossLevel)enemies.forEach(function(e){ctx.drawImage(enemyImage,e.x,e.y,e.size,e.size);});

  drawMedkits();

  dustParticles.forEach(function(d){
    ctx.globalAlpha=d.alpha;
    ctx.fillStyle=d.color||'rgba(200,200,200,1)';
    ctx.fillRect(d.x-2,d.y-2,4,4);
  });
  ctx.globalAlpha=1;

  disintegrationEffects.forEach(function(e){ctx.save();ctx.globalAlpha=e.alpha;ctx.fillStyle=e.color;ctx.shadowColor=e.color;ctx.shadowBlur=10;ctx.beginPath();ctx.arc(e.x,e.y,e.size,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.restore();});
  deathEffects.forEach(function(e){ctx.save();if(e.type==='shockwave'){ctx.globalAlpha=e.alpha*0.6;ctx.strokeStyle=e.color;ctx.lineWidth=4;ctx.shadowColor=e.color;ctx.shadowBlur=15;ctx.beginPath();ctx.arc(e.x,e.y,e.radius,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;}else{ctx.globalAlpha=e.alpha;ctx.fillStyle=e.color;ctx.shadowColor=e.color;ctx.shadowBlur=8;ctx.beginPath();ctx.arc(e.x,e.y,e.size,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;}ctx.restore();});

  voidRifts.forEach(function(r){ctx.save();ctx.translate(r.x,r.y);ctx.rotate(r.rotation);var rg=ctx.createRadialGradient(0,0,0,0,0,r.size);rg.addColorStop(0,'rgba(153,51,255,'+r.alpha+')');rg.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=rg;ctx.beginPath();ctx.arc(0,0,r.size,0,Math.PI*2);ctx.fill();ctx.restore();});
  energyWaves.forEach(function(w){ctx.save();ctx.strokeStyle=w.color;ctx.globalAlpha=w.alpha;ctx.lineWidth=8;ctx.shadowColor=w.color;ctx.shadowBlur=20;ctx.beginPath();ctx.arc(w.x,w.y,w.radius,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;ctx.restore();});

  if(warningFlash>0){ctx.fillStyle='rgba(255,0,0,'+warningFlash+')';ctx.fillRect(0,0,canvas.width,canvas.height);}

  // Boss intro overlays
  if(isBossLevel&&bossType==='mecha'&&boss.state==='comic_intro'){
    if(boss.entryPhase===0){
      ctx.fillStyle='rgba(0,0,0,0.85)';ctx.fillRect(0,0,canvas.width,canvas.height);
      if(bossNameReveal){
        var op=Math.min(1,(4.5-boss.stateTimer)/1.5);
        ctx.save();ctx.shadowColor='#4488ff';ctx.shadowBlur=50+Math.sin(boss.animationTimer*10)*20;
        ctx.fillStyle='rgba(255,255,255,'+op+')';ctx.font='bold 56px Arial';ctx.textAlign='center';
        ctx.strokeStyle='rgba(68,136,255,'+op+')';ctx.lineWidth=5;
        var sc=1+Math.sin(boss.animationTimer*8)*0.12;
        ctx.translate(canvas.width/2,canvas.height/2);ctx.scale(sc,sc);
        ctx.strokeText('IRON DESTROYER',0,0);ctx.fillText('IRON DESTROYER',0,0);
        ctx.fillStyle='rgba(180,200,255,'+op+')';ctx.font='bold 20px Arial';
        ctx.fillText('GUARDIAN OF THE IRON DUNGEON',0,55);ctx.restore();
      }
    }
  }

  if(isBossLevel&&bossType==='void'&&boss.state==='comic_intro'){
    if(boss.entryPhase===0||boss.entryPhase===1){
      ctx.fillStyle='rgba(0,0,0,0.85)';ctx.fillRect(0,0,canvas.width,canvas.height);
      if(bossNameReveal){
        var tip=boss.entryPhase===0?(9-boss.stateTimer):(7.5-boss.stateTimer+1.5);
        var op=Math.min(1,tip/1);
        ctx.save();ctx.shadowColor='#9933ff';ctx.shadowBlur=50+Math.sin(boss.animationTimer*10)*20;
        ctx.fillStyle='rgba(255,255,255,'+op+')';ctx.font='bold 64px Arial';ctx.textAlign='center';
        ctx.strokeStyle='rgba(153,51,255,'+op+')';ctx.lineWidth=5;
        var sc=1+Math.sin(boss.animationTimer*8)*0.15;ctx.translate(canvas.width/2,canvas.height/2);ctx.scale(sc,sc);
        ctx.strokeText('VOID PHANTOM',0,0);ctx.fillText('VOID PHANTOM',0,0);
        if(tip>0.5){var so=Math.min(1,(tip-0.5)/0.8);ctx.fillStyle='rgba(200,150,255,'+so+')';ctx.font='bold 22px Arial';ctx.fillText('MASTER OF THE VOID',0,60);}
        ctx.restore();
      }
    }
  }

  if(isBossLevel&&bossType==='oni'&&boss.state==='comic_intro'){
    if(boss.entryPhase===0){
      ctx.fillStyle='rgba(0,0,0,0.85)';ctx.fillRect(0,0,canvas.width,canvas.height);
      if(bossNameReveal){
        var op=Math.min(1,(5-boss.stateTimer)/1.2);
        ctx.save();ctx.shadowColor='#ee4400';ctx.shadowBlur=60+Math.sin(boss.animationTimer*10)*20;
        ctx.fillStyle='rgba(255,255,255,'+op+')';ctx.font='bold 52px Arial';ctx.textAlign='center';
        ctx.strokeStyle='rgba(200,60,0,'+op+')';ctx.lineWidth=5;
        var sc=1+Math.sin(boss.animationTimer*8)*0.12;ctx.translate(canvas.width/2,canvas.height/2);ctx.scale(sc,sc);
        ctx.strokeText('YAMATA-ONI',0,-20);ctx.fillText('YAMATA-ONI',0,-20);
        ctx.fillStyle='rgba(255,180,100,'+op+')';ctx.font='bold 16px Arial';
        ctx.fillText('八 DEMON OF THE ONI SANCTUM 岐',0,30);
        if(numPlayers===2){ctx.fillStyle='rgba(255,220,100,'+op+')';ctx.font='bold 10px Arial';ctx.fillText('TEAMWORK REQUIRED — SPLIT UP TO SHATTER THE SHRINES!',0,65);}
        ctx.restore();
      }
    } else if(boss.entryPhase===1){
      var gr=ctx.createRadialGradient(boss.x+boss.size/2,boss.y+boss.size/2,0,boss.x+boss.size/2,boss.y+boss.size/2,280);
      gr.addColorStop(0,'rgba(200,60,0,'+(boss.flashIntensity*0.4)+')');gr.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=gr;ctx.fillRect(0,0,canvas.width,canvas.height);
    }
  }

  if(fadeOpacity>0){ctx.fillStyle='rgba(0,0,0,'+fadeOpacity+')';ctx.fillRect(0,0,canvas.width,canvas.height);}
  if(freezeTime>0){ctx.fillStyle='rgba(255,255,255,0.3)';ctx.fillRect(0,0,canvas.width,canvas.height);}
  ctx.restore();
}

// ═══════════════════════════════════════════════════
//   GAME LOOP
// ═══════════════════════════════════════════════════
function gameLoop(timestamp){
  var dt=(timestamp-(lastTime||timestamp))/1000;
  dt=Math.min(dt,0.05);
  lastTime=timestamp;
  update(dt);
  draw();
  if(gameRunning||stageTransitionActive||(isBossLevel&&boss&&boss.state==='comic_intro')||(isBossLevel&&boss&&boss.state==='dead'&&bossDeadTimer<BOSS_DEAD_DELAY)){
    animFrameId=requestAnimationFrame(gameLoop);
  } else {
    animFrameId=null;
  }
}

// Assets
var assetsLoaded=0;
function checkStart(){assetsLoaded++;}
