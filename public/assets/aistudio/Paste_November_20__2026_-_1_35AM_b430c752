function drawMedkits(){
  var t=Date.now()/600;
  medkits.forEach(function(m){
    var bobY=Math.sin(t+m.bob)*4, cx=m.x+m.size/2, cy=m.y+m.size/2+bobY;
    var glow=ctx.createRadialGradient(cx,cy,0,cx,cy,24);
    glow.addColorStop(0,'rgba(0,255,100,0.4)'); glow.addColorStop(1,'rgba(0,255,100,0)');
    ctx.fillStyle=glow; ctx.beginPath(); ctx.arc(cx,cy,24,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#ffffff'; ctx.fillRect(m.x,m.y+bobY,m.size,m.size);
    ctx.fillStyle='#00cc44';
    var cw=m.size*0.25;
    ctx.fillRect(m.x+2,m.y+bobY+m.size/2-cw/2,m.size-4,cw);
    ctx.fillRect(m.x+m.size/2-cw/2,m.y+bobY+2,cw,m.size-4);
    ctx.strokeStyle='#ff4444'; ctx.lineWidth=2;
    ctx.shadowColor='#00ff66'; ctx.shadowBlur=10;
    ctx.strokeRect(m.x,m.y+bobY,m.size,m.size); ctx.shadowBlur=0;
  });
}

