function addParticle(p){if(dustParticles.length>=MAX_PARTICLES)dustParticles.shift();dustParticles.push(p);}

function createDisintegrationEffect(x,y,size){
  for(var i=0;i<8;i++){
    var angle=(i/8)*Math.PI*2, speed=50+Math.random()*100;
    disintegrationEffects.push({x:x+size/2,y:y+size/2,dx:Math.cos(angle)*speed,dy:Math.sin(angle)*speed,size:3+Math.random()*3,alpha:1,color:'#ff4400',lifetime:0.6});
  }
}

function createDeathEffect(x,y,size,color){
  deathEffects.push({type:'shockwave',x:x+size/2,y:y+size/2,radius:0,maxRadius:80,alpha:1,color:color,lifetime:0.8});
  for(var i=0;i<12;i++){
    var a=(i/12)*Math.PI*2, sp=100+Math.random()*150;
    deathEffects.push({type:'particle',x:x+size/2,y:y+size/2,dx:Math.cos(a)*sp,dy:Math.sin(a)*sp,size:4+Math.random()*4,alpha:1,color:color,lifetime:1.0});
  }
}

function createComicSlash(x,y,angle,length){
  return{x:x,y:y,angle:angle,length:length,alpha:1,lifetime:0.8,timer:0,thickness:Math.random()*15+10};
}

function getRandomAlivePlayer(){
  var alive=players.filter(function(p){return p.state==='alive';});
  if(!alive.length){
    var any=players.filter(function(p){return p.state!=='spectator';});
    return any.length ? any[Math.floor(Math.random()*any.length)] : players[0];
  }
  return alive[Math.floor(Math.random()*alive.length)];
}

