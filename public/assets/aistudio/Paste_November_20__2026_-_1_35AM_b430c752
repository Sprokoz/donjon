<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>DUNGEON BOUNCER — Iron Depths, The Void & Oni Sanctum</title>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin:0; overflow:hidden; background:#020008; font-family:Arial,sans-serif; }
    #gameCanvas { display:block; background:#1a0033; width:800px; height:600px; margin:20px auto; border:5px solid #9933ff;
      box-shadow:0 0 30px rgba(153,51,255,0.5),inset 0 0 50px rgba(153,51,255,0.1); }

    .game-screen {
      position:fixed; inset:0;
      display:flex; flex-direction:column;
      align-items:center; justify-content:center;
      z-index:9999; overflow:hidden;
    }
    .screen-bg { background:#020008; }
    .screen-scanlines::before {
      content:''; position:absolute; inset:0;
      background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(153,51,255,0.03) 2px,rgba(153,51,255,0.03) 4px);
      pointer-events:none; animation:scanlines 8s linear infinite;
    }
    @keyframes scanlines { from{background-position:0 0} to{background-position:0 100px} }

    .diff-stars { position:absolute; inset:0; pointer-events:none; }
    .diff-star { position:absolute; background:white; image-rendering:pixelated; animation:starBlink var(--dur,2s) var(--del,0s) infinite; }
    @keyframes starBlink { 0%,100%{opacity:0.2} 50%{opacity:1} }

    .screen-title {
      font-family:'Press Start 2P',monospace; font-size:22px; color:#fff;
      text-shadow:0 0 20px #9933ff,0 0 40px #9933ff,4px 4px 0 #330066;
      letter-spacing:2px; animation:titlePulse 2s ease-in-out infinite;
      text-align:center; margin-bottom:8px;
    }
    .screen-title-sub {
      font-family:'Press Start 2P',monospace; font-size:9px; color:#8855cc;
      text-align:center; margin-bottom:4px;
    }
    .screen-subtitle { font-family:'Press Start 2P',monospace; font-size:8px; color:#8855cc; animation:blink 1s step-end infinite; margin-top:10px; }
    @keyframes titlePulse { 0%,100%{text-shadow:0 0 20px #9933ff,0 0 40px #9933ff,4px 4px 0 #330066} 50%{text-shadow:0 0 30px #cc66ff,0 0 60px #cc66ff,4px 4px 0 #220044} }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

    #difficultyScreen { display:flex; }
    .diff-selector { display:flex; flex-direction:column; gap:16px; margin-top:20px; align-items:center; }
    .diff-btn {
      font-family:'Press Start 2P',monospace; position:relative; width:460px;
      padding:0; border:none; cursor:pointer; background:transparent; outline:none; transition:transform 0.1s;
    }
    .diff-btn:hover { transform:scale(1.04); } .diff-btn:active { transform:scale(0.97); }
    .diff-btn-inner { display:block; padding:14px 22px; border:4px solid var(--border); position:relative; overflow:hidden; }
    .diff-btn-inner::before { content:''; position:absolute; inset:0; background:var(--bg); opacity:0.12; }
    .diff-btn:hover .diff-btn-inner::before { opacity:0.22; }
    .diff-btn-glow { position:absolute; inset:-6px; background:radial-gradient(ellipse,var(--color) 0%,transparent 70%); opacity:0; filter:blur(8px); transition:opacity 0.2s; pointer-events:none; }
    .diff-btn:hover .diff-btn-glow { opacity:0.25; }
    .diff-btn .btn-label { font-size:18px; color:var(--color); text-shadow:3px 3px 0 var(--shadow),0 0 20px var(--color); display:block; margin-bottom:6px; }
    .diff-btn .btn-stats { font-size:7px; color:rgba(255,255,255,0.7); display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
    .diff-btn .btn-stat { color:var(--color); opacity:0.9; }
    .diff-pixel-hearts { display:flex; gap:3px; justify-content:center; margin-top:4px; }
    .cursor-arrow { display:inline-block; width:10px; height:10px; background:var(--color); clip-path:polygon(0 0,100% 50%,0 100%); margin-right:8px; vertical-align:middle; opacity:0; transition:opacity 0.15s; }
    .diff-btn:hover .cursor-arrow { opacity:1; }
    .diff-btn.easy { --color:#44ff88; --border:#22aa55; --bg:#00ff66; --shadow:#003311; }
    .diff-btn.medium { --color:#ffcc00; --border:#aa8800; --bg:#ffcc00; --shadow:#332200; }
    .diff-btn.hard { --color:#ff4444; --border:#aa1111; --bg:#ff0000; --shadow:#330000; }

    #playerCountScreen { display:none; }
    .pcount-selector { display:flex; gap:30px; margin-top:30px; }
    .pcount-btn {
      font-family:'Press Start 2P',monospace; position:relative; width:200px; height:220px;
      border:none; cursor:pointer; background:transparent; outline:none; transition:transform 0.15s;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
    }
    .pcount-btn:hover { transform:scale(1.06); }
    .pcount-btn:active { transform:scale(0.95); }
    .pcount-inner {
      width:100%; height:100%; border:4px solid var(--border); position:relative;
      display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px;
    }
    .pcount-inner::before { content:''; position:absolute; inset:0; background:var(--bg); opacity:0.1; }
    .pcount-btn:hover .pcount-inner::before { opacity:0.2; }
    .pcount-btn .pcount-glow { position:absolute; inset:-8px; background:radial-gradient(ellipse,var(--color) 0%,transparent 70%); opacity:0; filter:blur(12px); transition:opacity 0.2s; pointer-events:none; }
    .pcount-btn:hover .pcount-glow { opacity:0.3; }
    .pcount-canvas { image-rendering:pixelated; }
    .pcount-label { font-family:'Press Start 2P',monospace; font-size:13px; color:var(--color); text-shadow:2px 2px 0 var(--shadow),0 0 15px var(--color); }
    .pcount-desc { font-family:'Press Start 2P',monospace; font-size:6px; color:rgba(255,255,255,0.6); text-align:center; padding:0 8px; }
    .p1btn { --color:#00ffff; --border:#00aaaa; --bg:#00ffff; --shadow:#001122; }
    .p2btn { --color:#ff88ff; --border:#aa44aa; --bg:#ff00ff; --shadow:#220022; }

    #colorPickScreen { display:none; }
    .color-pick-wrap { display:flex; gap:40px; margin-top:24px; }
    .color-pick-panel {
      display:flex; flex-direction:column; align-items:center; gap:10px;
      border:3px solid #444; padding:18px 20px; border-radius:8px;
      background:rgba(255,255,255,0.04);
    }
    .color-pick-label { font-family:'Press Start 2P',monospace; font-size:10px; margin-bottom:4px; }
    .color-pick-label.p1 { color:#00ffff; text-shadow:0 0 10px #00ffff; }
    .color-pick-label.p2 { color:#ff88ff; text-shadow:0 0 10px #ff88ff; }
    .color-swatches { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
    .color-swatch {
      width:40px; height:40px; border-radius:6px; cursor:pointer;
      border:3px solid rgba(255,255,255,0.2); transition:transform 0.15s, border-color 0.15s;
      position:relative;
    }
    .color-swatch:hover { transform:scale(1.15); border-color:rgba(255,255,255,0.8); }
    .color-swatch.selected { border-color:#ffffff; box-shadow:0 0 12px currentColor; transform:scale(1.12); }
    .color-swatch.selected::after { content:'✓'; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:18px; color:#fff; font-weight:bold; text-shadow:1px 1px 3px #000; }
    .color-preview-box {
      width:80px; height:80px; border-radius:10px; border:4px solid rgba(255,255,255,0.3);
      display:flex; align-items:center; justify-content:center;
      font-family:'Press Start 2P',monospace; font-size:8px; color:rgba(0,0,0,0.7);
      font-weight:bold; transition:background 0.3s, box-shadow 0.3s;
    }
    .start-game-btn {
      font-family:'Press Start 2P',monospace; font-size:13px; margin-top:18px;
      padding:14px 36px; border:4px solid #9933ff; background:rgba(153,51,255,0.2);
      color:#cc88ff; cursor:pointer; border-radius:6px; transition:all 0.2s;
      text-shadow:0 0 10px #9933ff;
    }
    .start-game-btn:hover { background:rgba(153,51,255,0.5); color:#fff; transform:scale(1.05); box-shadow:0 0 20px #9933ff; }

    #stageTransition {
      display:none; position:fixed; inset:0; z-index:8888;
      background:#000; flex-direction:column;
      align-items:center; justify-content:center;
    }
    #stageTransition.active { display:flex; }
    .trans-line {
      font-family:'Press Start 2P',monospace; text-align:center;
      opacity:0; transform:translateY(20px);
      transition:all 0.6s ease; margin:8px 0;
    }
    .trans-line.show { opacity:1; transform:translateY(0); }
    #transLine1 { font-size:20px; color:#44ff88; text-shadow:0 0 20px #44ff88,0 0 40px #44ff88; }
    #transStars { font-size:28px; color:#ffdd00; text-shadow:0 0 15px #ffdd00; letter-spacing:12px; }
    #transLine2 { font-size:10px; color:#666; margin-top:20px; }
    #transLine3 { font-size:16px; color:#9933ff; text-shadow:0 0 20px #9933ff,0 0 40px #9933ff; margin-top:30px; }
    #transLine4 { font-size:9px; color:#cc66ff; animation:blink 0.8s step-end infinite; }
    .trans-divider { width:300px; height:2px; background:linear-gradient(90deg,transparent,#9933ff,transparent); margin:20px auto; opacity:0; transition:opacity 0.6s; }
    .trans-divider.show { opacity:1; }

    #enemyCount { position:absolute; top:10px; left:10px; color:#ffff00; font-size:9px; font-weight:bold; background:rgba(0,0,0,0.9); padding:6px 10px; border-radius:6px; border:2px solid #ffff00; font-family:'Press Start 2P',monospace; }
    #stageIndicator { position:absolute; top:10px; left:50%; transform:translateX(-50%); color:#9933ff; font-size:8px; background:rgba(0,0,0,0.9); padding:5px 12px; border-radius:6px; border:2px solid #9933ff; font-family:'Press Start 2P',monospace; display:none; white-space:nowrap; }

    #bossHealthBar { position:absolute; bottom:78px; left:50%; transform:translateX(-50%); background:linear-gradient(145deg,#1a1a1a,#333); padding:8px 14px; border-radius:10px; color:white; font-size:14px; display:none; width:340px; border:3px solid #666; box-shadow:inset 0 2px 10px rgba(255,0,0,0.3); z-index:50; }
    .boss-name { text-align:center; font-weight:bold; color:#ff6666; margin-bottom:6px; font-size:9px; font-family:'Press Start 2P',monospace; text-shadow:0 0 10px #ff0000; }
    .health-bar-container { width:100%; height:18px; background:linear-gradient(145deg,#1a1a1a,#2a2a2a); border-radius:10px; margin:5px 0; border:2px solid #555; position:relative; overflow:hidden; }
    .health-bar-fill { height:100%; background:linear-gradient(90deg,#ff0000,#ff4444,#ff6666); border-radius:8px; transition:width 0.4s ease; box-shadow:inset 0 2px 8px rgba(255,255,255,0.2),0 0 10px rgba(255,0,0,0.5); }
    .health-text { text-align:center; font-size:8px; margin-top:3px; color:#ccc; font-family:'Press Start 2P',monospace; }
    .phase-bar { width:100%; height:4px; background:#333; border-radius:4px; margin-top:4px; overflow:hidden; }
    .phase-fill { height:100%; border-radius:4px; transition:width 0.4s ease; }

    #p1Hud,#p2Hud { position:absolute; bottom:10px; background:rgba(0,0,0,0.9); border-radius:8px; padding:6px 10px; border:2px solid; }
    #p1Hud { left:10px; border-color:#00ffff; } #p2Hud { right:10px; border-color:#ff00ff; }
    #p2Hud.solo-hidden { display:none; }
    .hud-label { font-family:'Press Start 2P',monospace; font-size:7px; margin-bottom:4px; display:block; }
    #p1Hud .hud-label { color:#00ffff; } #p2Hud .hud-label { color:#ff00ff; }
    .hud-hearts { display:flex; gap:2px; align-items:center; margin-bottom:3px; }
    .hud-dash { font-family:'Press Start 2P',monospace; font-size:6px; color:#aaa; margin-top:3px; }

    #dashCooldown { position:absolute; bottom:55px; left:10px; color:#00ffff; font-size:7px; background:rgba(0,0,0,0.9); padding:4px 7px; border-radius:5px; border:2px solid #00ffff; font-family:'Press Start 2P',monospace; }
    #dashCooldownP2 { position:absolute; bottom:55px; right:10px; color:#ff00ff; font-size:7px; background:rgba(0,0,0,0.9); padding:4px 7px; border-radius:5px; border:2px solid #ff00ff; font-family:'Press Start 2P',monospace; text-align:right; }
    #dashCooldownP2.solo-hidden { display:none; }
    #gameOver { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:red; font-size:28px; display:none; background:rgba(0,0,0,0.9); padding:30px; border-radius:15px; user-select:none; text-align:center; border:3px solid #ff0000; font-family:'Press Start 2P',monospace; }
    #victory { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:lime; font-size:24px; display:none; background:rgba(0,0,0,0.9); padding:30px; border-radius:15px; user-select:none; text-align:center; border:3px solid #00ff00; font-family:'Press Start 2P',monospace; }
    button { cursor:pointer; border:none; border-radius:8px; padding:12px 24px; font-weight:bold; font-size:12px; transition:all 0.3s ease; font-family:'Press Start 2P',monospace; }
    #restartBtn { position:absolute; top:63%; left:50%; transform:translate(-50%,-50%); display:none; background:linear-gradient(145deg,#0066cc,#004499); color:white; border:2px solid #0099ff; }
    #menuBtn { position:absolute; top:73%; left:50%; transform:translate(-50%,-50%); display:none; background:linear-gradient(145deg,#cc6600,#994400); color:white; border:2px solid #ff9900; }
    #muteBtn { position:absolute; bottom:10px; left:50%; transform:translateX(-50%); padding:5px 10px; font-size:7px; border-radius:5px; border:2px solid #ff9900; cursor:pointer; background:linear-gradient(145deg,#cc6600,#994400); color:#fff; font-family:'Press Start 2P',monospace; }
    #controlsBtn { position:absolute; bottom:35px; left:50%; transform:translateX(-50%); padding:5px 10px; font-size:7px; border-radius:5px; border:2px solid #0099ff; cursor:pointer; background:linear-gradient(145deg,#0066cc,#004499); color:#fff; font-family:'Press Start 2P',monospace; }
    #controlsModal { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.95); padding:28px; border-radius:15px; border:3px solid #0099ff; display:none; z-index:1000; min-width:480px; }
    #controlsModal h2 { color:#fff; text-align:center; margin-bottom:18px; font-family:'Press Start 2P',monospace; font-size:12px; }
    .controls-section { margin-bottom:20px; }
    .controls-section h3 { color:#0099ff; margin-bottom:8px; font-size:11px; font-family:'Press Start 2P',monospace; }
    .control-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; color:#fff; font-family:'Press Start 2P',monospace; font-size:9px; }
    .control-row label { flex:1; }
    .control-row button { padding:6px 14px; background:#333; color:#fff; border:2px solid #0099ff; border-radius:6px; cursor:pointer; min-width:70px; font-family:'Press Start 2P',monospace; font-size:8px; }
    .control-row button:hover { background:#0099ff; }
    .control-row button.listening { background:#ff9900; border-color:#ff9900; animation:pulse 1s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.6} }
    #closeControlsBtn { width:100%; padding:10px; margin-top:16px; background:linear-gradient(145deg,#cc6600,#994400); color:#fff; border:2px solid #ff9900; border-radius:8px; cursor:pointer; font-family:'Press Start 2P',monospace; font-size:10px; }
    #volumeControls { position:absolute; top:10px; right:10px; text-align:center; color:white; background:rgba(0,0,0,0.9); padding:5px 10px; border-radius:8px; font-size:8px; display:flex; flex-direction:column; gap:4px; border:2px solid #666; font-family:'Press Start 2P',monospace; }
    #volumeControls label { margin-right:3px; color:#fff; font-size:6px; }
    #volumeControls input[type="range"] { vertical-align:middle; width:60px; }
    #comboP1,#comboP2 { position:absolute; font-size:16px; font-weight:bold; color:#ffff00; text-shadow:0 0 10px #ff0000,0 0 20px #ff0000; display:none; animation:comboPopup 0.3s ease-out; z-index:100; font-family:'Press Start 2P',monospace; }
    #comboP1 { bottom:90px; left:10px; } #comboP2 { bottom:90px; right:10px; }
    @keyframes comboPopup { 0%{transform:scale(0.5);opacity:0} 50%{transform:scale(1.2)} 100%{transform:scale(1);opacity:1} }
    #medkitNotif { position:absolute; top:45px; left:50%; transform:translateX(-50%); background:rgba(0,180,0,0.9); color:#fff; padding:5px 12px; border-radius:6px; font-family:'Press Start 2P',monospace; font-size:7px; display:none; border:2px solid #00ff00; white-space:nowrap; }
    #diffBadge { position:absolute; top:10px; left:50%; transform:translateX(-50%); font-family:'Press Start 2P',monospace; font-size:7px; padding:3px 8px; border-radius:5px; border:2px solid; display:none; margin-top:2px; }
    #phaseAnnounce { position:absolute; top:40%; left:50%; transform:translate(-50%,-50%); font-family:'Press Start 2P',monospace; font-size:18px; color:#ff0000; text-shadow:0 0 20px #ff0000; display:none; text-align:center; pointer-events:none; z-index:200; }
    #medkitInventory { position:absolute; bottom:55px; left:50%; transform:translateX(-50%); font-family:'Press Start 2P',monospace; font-size:7px; color:#00ff88; background:rgba(0,0,0,0.9); padding:4px 8px; border-radius:5px; border:2px solid #00ff88; display:none; text-align:center; }
  </style>
</head>
<body>

<!-- DIFFICULTY SCREEN -->
<div id="difficultyScreen" class="game-screen screen-bg screen-scanlines">
  <div class="diff-stars" id="starsContainer1"></div>
  <div class="diff-title-wrap" style="text-align:center;margin-bottom:6px">
    <div class="screen-title">⚔ DUNGEON BOUNCER ⚔</div>
    <div class="screen-title-sub">IRON DEPTHS → THE VOID → ONI SANCTUM</div>
    <div class="screen-subtitle">▼ SELECT DIFFICULTY ▼</div>
  </div>
  <div class="diff-selector">
    <button class="diff-btn easy" onclick="selectDifficulty('easy')">
      <div class="diff-btn-glow"></div>
      <div class="diff-btn-inner">
        <span class="cursor-arrow"></span><span class="btn-label">EASY</span>
        <div class="diff-pixel-hearts" id="easyHearts"></div>
        <div class="btn-stats">
          <span class="btn-stat">5 HEARTS</span><span>|</span>
          <span class="btn-stat">MECHA: 20HP</span><span>|</span>
          <span class="btn-stat">VOID: 20HP</span><span>|</span>
          <span class="btn-stat">ONI: 25HP</span>
        </div>
      </div>
    </button>
    <button class="diff-btn medium" onclick="selectDifficulty('medium')">
      <div class="diff-btn-glow"></div>
      <div class="diff-btn-inner">
        <span class="cursor-arrow"></span><span class="btn-label">MEDIUM</span>
        <div class="diff-pixel-hearts" id="mediumHearts"></div>
        <div class="btn-stats">
          <span class="btn-stat">3 HEARTS</span><span>|</span>
          <span class="btn-stat">MECHA: 30HP</span><span>|</span>
          <span class="btn-stat">VOID: 35HP</span><span>|</span>
          <span class="btn-stat">ONI: 40HP</span>
        </div>
      </div>
    </button>
    <button class="diff-btn hard" onclick="selectDifficulty('hard')">
      <div class="diff-btn-glow"></div>
      <div class="diff-btn-inner">
        <span class="cursor-arrow"></span><span class="btn-label">HARD</span>
        <div class="diff-pixel-hearts" id="hardHearts"></div>
        <div class="btn-stats">
          <span class="btn-stat">1 HEART</span><span>|</span>
          <span class="btn-stat">REVIVE=MEDKIT</span><span>|</span>
          <span class="btn-stat">MECHA: 45HP</span><span>|</span>
          <span class="btn-stat">ONI: 55HP</span>
        </div>
      </div>
    </button>
  </div>
</div>

<!-- PLAYER COUNT SCREEN -->
<div id="playerCountScreen" class="game-screen screen-bg screen-scanlines">
  <div class="diff-stars" id="starsContainer2"></div>
  <div style="text-align:center;margin-bottom:8px">
    <div class="screen-title">⚔ SELECT MODE ⚔</div>
    <div class="screen-subtitle">▼ HOW MANY HEROES? ▼</div>
  </div>
  <div class="pcount-selector">
    <button class="pcount-btn p1btn" onclick="selectPlayerCount(1)">
      <div class="pcount-glow"></div>
      <div class="pcount-inner">
        <canvas id="p1CountCanvas" class="pcount-canvas" width="60" height="60"></canvas>
        <span class="pcount-label">1 PLAYER</span>
        <span class="pcount-desc">SOLO HERO<br>ALL GLORY YOURS</span>
      </div>
    </button>
    <button class="pcount-btn p2btn" onclick="selectPlayerCount(2)">
      <div class="pcount-glow"></div>
      <div class="pcount-inner">
        <canvas id="p2CountCanvas" class="pcount-canvas" width="90" height="60"></canvas>
        <span class="pcount-label">2 PLAYERS</span>
        <span class="pcount-desc">CO-OP HEROES<br>SHARE THE GLORY</span>
      </div>
    </button>
  </div>
</div>

<!-- COLOR PICKER SCREEN -->
<div id="colorPickScreen" class="game-screen screen-bg screen-scanlines">
  <div class="diff-stars" id="starsContainer3"></div>
  <div style="text-align:center;margin-bottom:6px">
    <div class="screen-title">⚔ CHOOSE COLORS ⚔</div>
    <div class="screen-subtitle">▼ PICK YOUR HERO COLORS ▼</div>
  </div>
  <div class="color-pick-wrap" id="colorPickWrap">
    <div class="color-pick-panel">
      <div class="color-pick-label p1">PLAYER 1</div>
      <div class="color-preview-box" id="p1ColorPreview" style="background:#00ffff;box-shadow:0 0 20px #00ffff;">P1</div>
      <div class="color-swatches" id="p1Swatches"></div>
    </div>
    <div class="color-pick-panel" id="p2ColorPanel">
      <div class="color-pick-label p2">PLAYER 2</div>
      <div class="color-preview-box" id="p2ColorPreview" style="background:#ff00ff;box-shadow:0 0 20px #ff00ff;">P2</div>
      <div class="color-swatches" id="p2Swatches"></div>
    </div>
  </div>
  <button class="start-game-btn" onclick="startWithColors()">▶ START GAME</button>
</div>

<!-- STAGE TRANSITION -->
<div id="stageTransition">
  <div class="trans-line" id="transLine1">✦ STAGE CLEARED ✦</div>
  <div class="trans-line" id="transStars">★ ★ ★</div>
