function spawnOniShrines(){
  oniShrines=[];
  var positions=numPlayers===2?
    [{x:80,y:80},{x:canvas.width-120,y:80}]:
    [{x:80,y:80},{x:canvas.width-120,y:canvas.height-120}];
  var isP2=boss.phase===2;
  positions.forEach(function(pos,idx){
    oniShrines.push({x:pos.x+20,y:pos.y+20,size:35,active:true,health:isP2?3:2,maxHealth:isP2?3:2,index:idx});
  });
}

function updateOniBoss(dt){
  if(!isBossLevel||boss.health<=0)return;
  var isP2=boss.phase===2;
  boss.animationTimer+=dt; boss.stateTimer-=dt;
  boss.pulseSize=1+Math.sin(boss.animationTimer*3)*0.1;
  boss.rotationAngle+=dt*(isP2?2:1);
  var cx=boss.x+boss.size/2, cy=boss.y+boss.size/2;

  players.forEach(function(p){
    if(p.sealed){p.sealTimer-=dt;if(p.sealTimer<=0){p.sealed=false;p.sealTimer=0;}}
  });

  for(var si=oniSpiritBombs.length-1;si>=0;si--){
    var bomb=oniSpiritBombs[si];
    bomb.lifetime-=dt;
    if(bomb.lifetime<=0){oniSpiritBombs.splice(si,1);continue;}
    var tp=getRandomAlivePlayer();
    var bdx=(tp.x+tp.size/2)-bomb.x, bdy=(tp.y+tp.size/2)-bomb.y;
    var bd=Math.sqrt(bdx*bdx+bdy*bdy)||1;
    bomb.vx+=(bdx/bd)*bomb.homingStr*dt;
    bomb.vy+=(bdy/bd)*bomb.homingStr*dt;
    var bspd=Math.sqrt(bomb.vx*bomb.vx+bomb.vy*bomb.vy);
    if(bspd>bomb.maxSpeed){bomb.vx=(bomb.vx/bspd)*bomb.maxSpeed;bomb.vy=(bomb.vy/bspd)*bomb.maxSpeed;}
    bomb.x+=bomb.vx;bomb.y+=bomb.vy;
    if(bomb.x<bomb.radius)bomb.vx=Math.abs(bomb.vx);
    if(bomb.x>canvas.width-bomb.radius)bomb.vx=-Math.abs(bomb.vx);
    if(bomb.y<bomb.radius)bomb.vy=Math.abs(bomb.vy);
    if(bomb.y>canvas.height-bomb.radius)bomb.vy=-Math.abs(bomb.vy);
    players.forEach(function(p){
      if(p.state==='alive'&&!p.dashImmune&&p.invulnFrames<=0&&p.postDashInvulnerability<=0){
        var dx=(p.x+p.size/2)-bomb.x, dy=(p.y+p.size/2)-bomb.y;
        if(Math.sqrt(dx*dx+dy*dy)<bomb.radius+p.size/2){
          damagePlayer(p,null,null);
          for(var pi2=0;pi2<12;pi2++){
            var ba=(pi2/12)*Math.PI*2;
            bossProjectiles.push({x:bomb.x,y:bomb.y,dx:Math.cos(ba)*4,dy:Math.sin(ba)*4,size:14,speed:1,color:isP2?'#ff0066':'#ff6600'});
          }
          oniSpiritBombs.splice(si,1);
        }
      }
    });
  }

  for(var zi=oniCursedZones.length-1;zi>=0;zi--){
    var zone=oniCursedZones[zi];
    zone.lifetime-=dt;
    if(zone.lifetime<=0){oniCursedZones.splice(zi,1);continue;}
    zone.alpha=Math.min(1,zone.lifetime/1.5)*0.7;
    if(zone.radius<zone.maxRadius)zone.radius+=zone.growthRate*dt;
    zone.damageTimer=(zone.damageTimer||0)+dt;
    if(zone.damageTimer>0.8){zone.damageTimer=0;
      players.forEach(function(p){
        if(p.state==='alive'&&!p.dashImmune&&p.invulnFrames<=0){
          var dx=(p.x+p.size/2)-zone.x, dy=(p.y+p.size/2)-zone.y;
          if(Math.sqrt(dx*dx+dy*dy)<zone.radius){damagePlayer(p,null,null);}
        }
      });
    }
  }

  oniShrines.forEach(function(shrine){
    if(!shrine.active)return;
    players.forEach(function(player){
      if(player.state==='alive'&&player.hasKnife&&
         Math.abs((player.x+player.size/2)-shrine.x)<shrine.size&&
         Math.abs((player.y+player.size/2)-shrine.y)<shrine.size){
        shrine.health--; player.hasKnife=false;
        screenShake=Math.max(screenShake,10);playSound(bossDamaged);
        for(var i=0;i<8;i++)addParticle({x:shrine.x,y:shrine.y,dx:(Math.random()-0.5)*150,dy:(Math.random()-0.5)*150,alpha:1,color:'#ff6600'});
        if(shrine.health<=0){shrine.active=false;playSound(bossDefeated);}
      }
    });
  });

  switch(boss.state){
    case 'comic_intro':
      if(boss.entryPhase===0){
        if(!bossNameReveal){bossNameReveal=true;playSound(bossEntrySound);playSound(bossNameRevealSound);screenShake=Math.max(screenShake,25);
          for(var i=0;i<20;i++)addParticle({x:canvas.width/2,y:canvas.height/2,dx:(Math.random()-0.5)*250,dy:(Math.random()-0.5)*250,alpha:1,color:'#ee4400'});
          for(var i=0;i<10;i++)comicSlashes.push(createComicSlash(Math.random()*canvas.width,Math.random()*canvas.height,Math.random()*Math.PI*2,80+Math.random()*120));
        }
        boss.y+=80*dt;
        if(boss.y>=boss.originalY){boss.y=boss.originalY;boss.entryPhase=1;boss.shakeIntensity=30;screenShake=Math.max(screenShake,30);playSound(bossLandingSound);
          for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*30,maxRadius:450,alpha:0.9,speed:240,color:'#ee4400'});
          for(var i=0;i<40;i++)addParticle({x:cx+(Math.random()-0.5)*200,y:boss.y+boss.size,dx:(Math.random()-0.5)*350,dy:-Math.random()*280,alpha:1,color:'#cc4400'});
        }
      } else if(boss.entryPhase===1){
        boss.shakeIntensity=Math.max(0,boss.shakeIntensity-dt*40);
        boss.flashIntensity=Math.sin(boss.animationTimer*8)*0.5+0.5;
      }
      if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1.5;boss.flashIntensity=0;bossNameReveal=false;comicSlashes=[];energyWaves=[];}
      break;

    case 'phase_transition':
      boss.pulseSize=1.3+Math.sin(boss.animationTimer*15)*0.5;boss.flashIntensity=0.9;screenShake=Math.max(screenShake,12);
      if(Math.random()<0.5)for(var i=0;i<3;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*400,dy:(Math.random()-0.5)*400,alpha:1,color:Math.random()>0.5?'#ff0066':'#ff4400'});
      if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1.2;playSound(bossLandingSound);screenShake=Math.max(screenShake,20);
        for(var i=0;i<3;i++){oniCursedZones.push({x:100+Math.random()*(canvas.width-200),y:100+Math.random()*(canvas.height-200),radius:20,maxRadius:90,growthRate:40,alpha:0.7,lifetime:8,color:'rgba(255,0,100,0.8)',damageTimer:0});}
      }
      break;

    case 'idle':
      boss.flashIntensity=Math.max(0,boss.flashIntensity-dt*2);
      if(boss.stateTimer<=0){
        boss.state='telegraph';boss.stateTimer=isP2?0.9:1.3;
        var p1attacks=['shrine_shatter','spirit_bomb','cursed_zone','katana_wave','oni_barrage'];
        var p2attacks=['shrine_shatter','spirit_bomb','cursed_zone','katana_wave','oni_barrage','soul_seal_combo'];
        boss.attackPattern=(isP2?p2attacks:p1attacks)[Math.floor(Math.random()*(isP2?p2attacks.length:p1attacks.length))];
        playSound(bossTelegraph);screenShake=Math.max(screenShake,5);boss.flashIntensity=1;
      }
      break;

    case 'telegraph':
      boss.flashIntensity=Math.sin(boss.animationTimer*10)*0.8;boss.pulseSize=1+Math.sin(boss.animationTimer*8)*0.35;
      if(boss.stateTimer<=0){
        boss.state='attacking';boss.stateTimer=isP2?3.0:3.5;boss.attackTimer=0;playSound(bossAttackVortex);
        if(boss.attackPattern==='shrine_shatter'){spawnOniShrines();showPhaseAnnounce(numPlayers===2?'⛩ DESTROY THE SHRINES! SPLIT UP!':'⛩ DESTROY THE SHRINES!','#ff6600');}
        else if(boss.attackPattern==='spirit_bomb'){showPhaseAnnounce('💀 SPIRIT BOMBS! DODGE THEM!','#ff0066');}
        else if(boss.attackPattern==='soul_seal_combo'){showPhaseAnnounce('封 SOUL SEALED! FREE EACH OTHER!','#ff0066');}
      }
      break;

    case 'attacking':
      boss.attackTimer+=dt;boss.flashIntensity=0.25;
      var spd=isP2?1.4:1.0;

      if(boss.attackPattern==='shrine_shatter'){
        var allDestroyed=oniShrines.every(function(s){return !s.active;});
        if(allDestroyed){boss.state='weakened';boss.stateTimer=isP2?2.0:3.0;boss.weakenedHits=0;boss.flashIntensity=0;boss.attacksBeforeVulnerable=0;boss.attacksNeeded=2+Math.floor(Math.random()*2);playSound(bossWeakened);return;}
        if(Math.floor(boss.attackTimer/2.0)>Math.floor((boss.attackTimer-dt)/2.0)){
          var tp=getRandomAlivePlayer();
          var dx=(tp.x+tp.size/2)-cx, dy=(tp.y+tp.size/2)-cy, d=Math.sqrt(dx*dx+dy*dy)||1;
          bossProjectiles.push({x:cx,y:cy,dx:(dx/d)*3,dy:(dy/d)*3,size:18,speed:1,color:'#ee4400',type:'homing',homingStr:0.05});
          playSound(projectileShootSound);
        }
        if(boss.stateTimer<=0&&!oniShrines.every(function(s){return !s.active;})){oniShrines=[];boss.state='idle';boss.stateTimer=1.5;boss.flashIntensity=0;}
      } else if(boss.attackPattern==='spirit_bomb'){
        if(boss.attackTimer>0.5&&Math.floor(boss.attackTimer/1.5)>Math.floor((boss.attackTimer-dt)/1.5)){
          var nb=isP2?3:2;
          for(var i=0;i<nb;i++){
            var angle=Math.random()*Math.PI*2, startDist=50;
            oniSpiritBombs.push({x:cx+Math.cos(angle)*startDist,y:cy+Math.sin(angle)*startDist,vx:Math.cos(angle)*0.5,vy:Math.sin(angle)*0.5,radius:28,maxSpeed:isP2?3.5:2.5,homingStr:isP2?120:80,lifetime:6});
          }
          playSound(bossEntrySound);
        }
        if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      } else if(boss.attackPattern==='cursed_zone'){
        if(Math.floor(boss.attackTimer/0.8)>Math.floor((boss.attackTimer-dt)/0.8)){
          var np=isP2?3:2;
          for(var i=0;i<np;i++){oniCursedZones.push({x:100+Math.random()*(canvas.width-200),y:100+Math.random()*(canvas.height-200),radius:20,maxRadius:isP2?100:75,growthRate:30,alpha:0.7,lifetime:6,color:isP2?'rgba(200,0,80,0.8)':'rgba(180,60,0,0.8)',damageTimer:0});}
          var px=100+Math.random()*(canvas.width-200), py=100+Math.random()*(canvas.height-200);
          var np2=6;
          for(var i=0;i<np2;i++){var ang=(i/np2)*Math.PI*2;bossProjectiles.push({x:px,y:py,dx:Math.cos(ang)*3*spd,dy:Math.sin(ang)*3*spd,size:12,speed:1,color:'#ff4400'});}
          playSound(bossAttackWall);
        }
        if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      } else if(boss.attackPattern==='katana_wave'){
        if(Math.floor(boss.attackTimer/0.7)>Math.floor((boss.attackTimer-dt)/0.7)){
          var waveNum=Math.floor(boss.attackTimer/0.7);
          var waveAngles=[(waveNum*0.4),(waveNum*0.4)+Math.PI/2,(waveNum*0.4)+Math.PI,(waveNum*0.4)+Math.PI*3/2];
          var safeIdx=Math.floor(Math.random()*4);
          var np=isP2?12:9;
          waveAngles.forEach(function(baseAng,idx){
            if(idx===safeIdx)return;
            for(var i=0;i<np;i++){
              var spread=(i-(np/2))*0.08;
              bossProjectiles.push({x:cx,y:cy,dx:Math.cos(baseAng+spread)*6.5*spd,dy:Math.sin(baseAng+spread)*6.5*spd,size:16,speed:1,color:isP2?'#cc0044':'#cc4400'});
            }
          });
          playSound(projectileShootSound);screenShake=Math.max(screenShake,4);
        }
        if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      } else if(boss.attackPattern==='oni_barrage'){
        if(Math.floor(boss.attackTimer/0.5)>Math.floor((boss.attackTimer-dt)/0.5)){
          var isFast=Math.floor(boss.attackTimer/0.5)%2===0;
          for(var i=0;i<8;i++){
            var ang=(i/8)*Math.PI*2+(boss.attackTimer*0.5);
            var projSpd=isFast?(8*spd):(2.5*spd);
            var projSize=isFast?12:22;
            bossProjectiles.push({x:cx,y:cy,dx:Math.cos(ang)*projSpd,dy:Math.sin(ang)*projSpd,size:projSize,speed:1,color:isFast?'#ffcc00':'#ff6600'});
          }
          playSound(projectileShootSound);
        }
        if(boss.stateTimer<=0){boss.attacksBeforeVulnerable++;if(boss.attacksBeforeVulnerable>=boss.attacksNeeded){boss.state='weakened';boss.stateTimer=isP2?2.0:3.0;boss.weakenedHits=0;boss.flashIntensity=0;boss.attacksBeforeVulnerable=0;boss.attacksNeeded=2+Math.floor(Math.random()*2);playSound(bossWeakened);}else{boss.state='idle';boss.stateTimer=isP2?0.5:1.0;boss.flashIntensity=0;}}
      } else if(boss.attackPattern==='soul_seal_combo'){
        if(boss.attackTimer<0.1){
          players.forEach(function(p){if(p.state==='alive'&&p.state!=='spectator'){p.sealed=true;p.sealTimer=isP2?2.5:2.0;}});
        }
        if(boss.attackTimer>1.2&&Math.floor(boss.attackTimer/1.2)>Math.floor((boss.attackTimer-dt)/1.2)){
          var nb=isP2?2:1;
          for(var i=0;i<nb;i++){var angle=Math.random()*Math.PI*2;oniSpiritBombs.push({x:cx+Math.cos(angle)*60,y:cy+Math.sin(angle)*60,vx:Math.cos(angle),vy:Math.sin(angle),radius:25,maxSpeed:isP2?3:2,homingStr:80,lifetime:5});}
          playSound(bossEntrySound);
        }
        if(boss.stateTimer<=0){boss.state='idle';boss.stateTimer=1;boss.flashIntensity=0;}
      }
      break;

    case 'weakened':
      boss.pulseSize=0.8+Math.sin(boss.animationTimer*6)*0.2;boss.flashIntensity=Math.sin(boss.animationTimer*4)*0.3;
      for(var pi2=0;pi2<players.length;pi2++){
        var player=players[pi2];
        if(player.state==='alive'&&player.hasKnife&&player.x<boss.x+boss.size&&player.x+player.size>boss.x&&player.y<boss.y+boss.size&&player.y+player.size>boss.y){
          boss.health--;boss.weakenedHits++;player.hasKnife=false;
          screenShake=Math.max(screenShake,15);freezeTime=0.15;updateBossHealthBar();playSound(bossDamaged);
          for(var i=0;i<10;i++)addParticle({x:cx,y:cy,dx:(Math.random()-0.5)*200,dy:(Math.random()-0.5)*200,alpha:1,color:'#ff4400'});
          var oniP2Thresh=diffSettings?diffSettings.oniPhase2HP:12;
          if(boss.health<=oniP2Thresh&&boss.phase===1){
            boss.phase=2;boss.state='phase_transition';boss.stateTimer=3.5;screenShake=Math.max(screenShake,25);playSound(bossEntrySound);
            for(var i=0;i<60;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*500,dy:(Math.random()-0.5)*500,alpha:1,color:'#ff0066'});
            for(var i=0;i<3;i++)energyWaves.push({x:cx,y:cy,radius:i*40,maxRadius:500,alpha:0.9,speed:320,color:'#ff0066'});
            showPhaseAnnounce('⚡ ONI RAGE! 怒 ⚡','#ff0066');
            players.forEach(function(p){p.sealed=false;p.sealTimer=0;});
            oniSpiritBombs=[];oniCursedZones=[];
            break;
          }
          if(boss.health<=0){boss.state='dead';bossDeadTimer=0;playSound(bossDefeated);
            for(var i=0;i<80;i++)dustParticles.push({x:cx,y:cy,dx:(Math.random()-0.5)*600,dy:(Math.random()-0.5)*600,alpha:1});
            oniShrines=[];oniSpiritBombs=[];oniCursedZones=[];
            screenShake=Math.max(screenShake,35);break;
          }
        }
      }
      if(boss.stateTimer<=0||boss.weakenedHits>=boss.maxWeakenedHits){boss.state='idle';boss.stateTimer=1.5;boss.flashIntensity=0;oniShrines=[];}
      break;
  }
}

// ═══════════════════════════════════════════════════
//   PLAYER UPDATE
// ═══════════════════════════════════════════════════
function updatePlayer(p, dt, controls){
  if(p.state!=='alive')return;
  if(p.postDashInvulnerability>0)p.postDashInvulnerability-=dt;
  if(p.invulnFrames>0)p.invulnFrames-=dt;
  var isVoidP2=bossType==='void'&&isBossLevel&&boss.phase===2;
  if(isVoidP2&&!p.dash2Active){p.dash2Active=true;p.dash2Ready=true;}

  if(p.sealed){
    p.dashTrail.forEach(function(t){t.alpha-=dt*3;});
    p.dashTrail=p.dashTrail.filter(function(t){return t.alpha>0;});
    if(numPlayers===2){
      var other=players.find(function(op){return op!==p&&op.state==='alive';});
      if(other){
        var dx=(other.x+other.size/2)-(p.x+p.size/2), dy=(other.y+other.size/2)-(p.y+p.size/2);
        if(Math.sqrt(dx*dx+dy*dy)<p.size*1.2){p.sealed=false;p.sealTimer=0;showPhaseAnnounce('SEAL BROKEN!','#00ff88');}
      }
    }
    return;
  }

  if(keys[controls.skill]&&!p._lastSkillPressed){
    if(p.dashReady){
      p.dashReady=false;p.dashImmune=true;p.dashTimeLeft=p.dashTime;p.dashCooldownTimer=p.dashCooldown;p.usingDash2=false;playSound(dashSound);
    } else if(p.dash2Active&&p.dash2Ready){
      p.dash2Ready=false;p.dashImmune=true;p.dashTimeLeft=p.dashTime;p.dash2CooldownTimer=10;p.usingDash2=true;playSound(dashSound);
    }
  }
  p._lastSkillPressed=keys[controls.skill];
  if(p.dashImmune&&p.dashTimeLeft>0){
    var ds=18;
    if(keys[controls.up])p.y-=ds;if(keys[controls.down])p.y+=ds;
    if(keys[controls.left])p.x-=ds;if(keys[controls.right])p.x+=ds;
    p.dashTrail.push({x:p.x,y:p.y,alpha:1});
    p.dashTimeLeft-=dt;
    if(p.dashTimeLeft<=0){p.dashImmune=false;p.postDashInvulnerability=0.25;}
  } else {
    if(keys[controls.up]&&p.y>0)p.y-=p.speed;if(keys[controls.down]&&p.y<canvas.height-p.size)p.y+=p.speed;
    if(keys[controls.left]&&p.x>0)p.x-=p.speed;if(keys[controls.right]&&p.x<canvas.width-p.size)p.x+=p.speed;
  }
  p.x=Math.max(0,Math.min(canvas.width-p.size,p.x));
  p.y=Math.max(0,Math.min(canvas.height-p.size,p.y));
  if(!p.dashReady){p.dashCooldownTimer-=dt;if(p.dashCooldownTimer<=0)p.dashReady=true;}
  if(isVoidP2&&!p.dash2Ready&&p.dash2CooldownTimer>0){p.dash2CooldownTimer-=dt;if(p.dash2CooldownTimer<=0)p.dash2Ready=true;}
  var ui=p.id===1?dashCooldownUI:dashCooldownUIP2;
  var hudDash=p.id===1?p1DashStatus:p2DashStatus;
  if(p.dashReady&&(!isVoidP2||p.dash2Ready)){
    ui.textContent='P'+p.id+(isVoidP2?' DASH x2':' DASH')+' READY';ui.style.color=playerColors[p.id].hex;
    hudDash.textContent=isVoidP2?'DASH x2 READY':'DASH READY';
  } else if(p.dashReady&&isVoidP2&&!p.dash2Ready){
    var cd2=Math.ceil(p.dash2CooldownTimer);ui.textContent='P'+p.id+' D2:'+cd2+'s';ui.style.color='#aaaaaa';hudDash.textContent='D1:RDY D2:'+cd2+'s';
  } else {
    var cd=Math.ceil(p.dashCooldownTimer);ui.textContent='P'+p.id+' CD:'+cd+'s';ui.style.color='#888888';
    hudDash.textContent='CD:'+cd+'s'+(isVoidP2?(p.dash2Ready?' D2:RDY':' D2:'+Math.ceil(p.dash2CooldownTimer)+'s'):'');
  }
  p.dashTrail.forEach(function(t){t.alpha-=dt*3;});
  p.dashTrail=p.dashTrail.filter(function(t){return t.alpha>0;});
}

function damagePlayer(player, arr, idx){
  if(player.invulnFrames>0||player.postDashInvulnerability>0)return;
  player.hearts--; player.invulnFrames=0.8;
  updateHeartsUI(player); screenShake=Math.max(screenShake,12); playSound(playerDeathSound);
  createDeathEffect(player.x,player.y,player.size,playerColors[player.id].hex);
  if(arr&&idx!==undefined)arr.splice(idx,1);
  if(player.hearts<=0){player.state='down';updateCombo(player.id);}
}

// ═══════════════════════════════════════════════════
//   COMBO
// ═══════════════════════════════════════════════════
function updateCombo(playerId){
  var c=playerCombos[playerId];c.count++;c.timer=1.0;
  var ui=playerId===1?comboP1UI:comboP2UI;
  ui.textContent=c.count+'x COMBO';ui.style.display='block';
  if(c.count>=10){ui.style.color='#ff00ff';ui.style.textShadow='0 0 15px #ff00ff';}
  else if(c.count>=5){ui.style.color='#ff6600';ui.style.textShadow='0 0 12px #ff6600';}
  else{ui.style.color='#ffff00';ui.style.textShadow='0 0 10px #ff0000';}
}
function resetCombo(pid){playerCombos[pid]={count:0,timer:0};(pid===1?comboP1UI:comboP2UI).style.display='none';}

